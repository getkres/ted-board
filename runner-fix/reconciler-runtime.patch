+   store.controls(board.call('control').get('commands',[]));store.tick(reconcile=True);store.collect_approvals(reconcile=True);store.sync_approval_status();store.flush()
+   if os.environ.get('TED_MOCKUP_AUTOARCHIVE_ENABLED')=='true':
