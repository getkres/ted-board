+"""Import and execute a candidate dispatcher, with provider boundaries isolated."""
+import importlib.util
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import types
+import unittest
+from unittest import mock
+from scripts import shared_admission
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+class DispatcherTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.root = Path(self.tmp.name).resolve()
+        client = types.ModuleType('board_client')
+        client.BoardConflict = type('BoardConflict', (Exception,), {})
+        client.BoardGone = type('BoardGone', (Exception,), {})
+        client.call = lambda *a, **k: self.fail('provider access is forbidden')
+        live = types.ModuleType('live_status')
+        live.instructions = lambda cid: ''
+        live.publish_live = lambda *a, **k: None
+        with mock.patch.dict(sys.modules, board_client=client, live_status=live):
+            spec = importlib.util.spec_from_file_location('candidate_sessions', ROOT / 'sessions.py')
+            self.module = importlib.util.module_from_spec(spec)
+            spec.loader.exec_module(self.module)
+        self.store = self.module.Store(self.root / 'jobs')
+        self.directory = self.store.root / 'card-sample'
+        self.directory.mkdir()
+        self.turn = dict(id='turn1', message='synthetic', kind='work')
+        session = dict(card_id='sample', engine='codex', cwd=str(self.directory), status='queued',
+                       last_line='queued', queue=[self.turn], title='synthetic', turn='old',
+                       started_at=None, last_activity=0, pid=None, identity='')
+        with self.store.locked() as data:
+            data['sessions']['sample'] = session
+        self.gate = shared_admission.Gate(self.root / 'budget', sample=lambda: dict(
+            cores=18, load=0, available_bytes=1024**3, total_bytes=64*1024**3))
+
+    def test_pressure_deferral_preserves_turn_and_never_launches_model(self):
+        with mock.patch.object(shared_admission, 'Gate', return_value=self.gate), \
+             mock.patch.object(self.module.os, 'getloadavg', return_value=(0, 0, 0)), \
+             mock.patch.object(self.module.subprocess, 'Popen', side_effect=AssertionError('model launch before admission')):
+            self.store.tick()
+        session = self.store.read()['sessions']['sample']
+        self.assertEqual(session['queue'], [self.turn])
+        self.assertEqual(session['status'], 'queued')
+        self.assertIsNone(session['pid'])
+
+    def test_review_and_veto_authority_are_reset_on_deferral(self):
+        with self.store.locked() as data:
+            s = data['sessions']['sample']
+            s['queue'][0].update(kind='review', approval_id='a', veto_proposal_id='v', veto_card_revision=2)
+            data['approvals']['a'] = dict(id='a', status='approved', kind='email', digest='safe', content='synthetic')
+        with mock.patch.object(shared_admission, 'Gate', return_value=self.gate), \
+             mock.patch.object(self.module.os, 'getloadavg', return_value=(0, 0, 0)), \
+             mock.patch.object(self.module, 'artifact', return_value=dict(digest='safe'), create=True), \
+             mock.patch.object(self.module.subprocess, 'Popen', side_effect=AssertionError('model launch before admission')):
+            self.store.tick()
+        data = self.store.read()
+        s = data['sessions']['sample']
+        self.assertEqual(s['queue'][0]['id'], 'turn1')
+        self.assertNotIn('reviewing', s)
+        self.assertNotIn('review_context', s)
+        self.assertNotIn('active_veto_revision', s)
+        self.assertEqual(data['approvals']['a']['status'], 'approved')
+
