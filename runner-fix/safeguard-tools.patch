+            self.assertNotIn(str(fifo).encode(), output + errors)
+
+    def test_actual_inventory_read_has_a_size_budget(self):
+        result = self.run_check({'expiries': [dict(name='cert', expires_at='2027-10-17T00:00:00Z',
