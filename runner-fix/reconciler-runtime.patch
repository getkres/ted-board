+ if INITIAL_DIGEST_ID not in completed:
+  covered=[a for a in actions if a['kind'] in ESCALATIONS]
+  if covered:
+   ranked={x['id']:x for a in covered for x in rows(a)}
+   ranked=sorted(ranked.values(),key=lambda x:(stamp(x.get('action_started_at')),x.get('priority',2),x['id']))
+   actions=[a for a in actions if a['kind'] not in ESCALATIONS]
+   actions.insert(0,dict(id=INITIAL_DIGEST_ID,kind='escalation_digest',entity=DIGEST_CARD_ID,payload=dict(card_id=DIGEST_CARD_ID,covered_ids=[a['id'] for a in covered],items=ranked)))
