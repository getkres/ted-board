+import datetime as dt
+import json
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+from unittest.mock import patch
+
+SCRIPT = Path(__file__).resolve().parents[1] / 'scripts' / 'ops_preflight.py'
+NOW = '2026-10-24T06:00:00+00:00'
+STAMP = dt.datetime.fromisoformat(NOW).timestamp()
+
+
+class PreflightTests(unittest.TestCase):
+    def run_check(self, inventory):
+        with tempfile.TemporaryDirectory() as root:
+            config = Path(root) / 'inventory.json'
+            config.write_text(json.dumps(inventory))
+            result = subprocess.run([sys.executable, str(SCRIPT), '--inventory', str(config),
+                                     '--now', NOW], capture_output=True, text=True)
+        return result
+
+    def test_reports_stale_missing_future_and_fresh_heartbeats(self):
+        import os
+        with tempfile.TemporaryDirectory() as root:
+            rows = []
+            for name, age in [('fresh', 30), ('stale', 601), ('future', -300)]:
+                path = Path(root) / name
+                path.touch()
+                os.utime(path, (STAMP - age, STAMP - age))
+                rows.append(dict(name=name, path=str(path), max_age_seconds=600))
+            rows.append(dict(name='missing', path=str(Path(root) / 'absent'), max_age_seconds=600))
+            result = self.run_check({'heartbeats': rows})
+        self.assertEqual(result.returncode, 1, result.stderr)
+        report = json.loads(result.stdout)
+        self.assertEqual({c['name']: c['status'] for c in report['checks']},
+                         {'fresh': 'ok', 'stale': 'warning', 'future': 'unknown', 'missing': 'unknown'})
+
+    def test_warns_on_expired_and_soon_expiring_metadata(self):
+        result = self.run_check({'expiries': [
+            dict(name='expired', expires_at='2026-10-23T06:00:00Z'),
+            dict(name='soon', expires_at='2026-11-01T06:00:00Z'),
+            dict(name='later', expires_at='2027-04-06T00:00:00Z'),
+            dict(name='untracked', expires_at=None)]})
+        self.assertEqual(result.returncode, 1, result.stderr)
+        checks = {c['name']: c for c in json.loads(result.stdout)['checks']}
+        self.assertEqual(checks['expired']['days_left'], -1)
+        self.assertEqual(checks['soon']['status'], 'warning')
+        self.assertEqual(checks['later']['status'], 'ok')
+        self.assertEqual(checks['untracked']['status'], 'unknown')
+
+    def test_warns_on_disk_threshold_and_log_size_without_reading_log(self):
+        with tempfile.TemporaryDirectory() as root:
+            log = Path(root) / 'private.log'
+            log.write_text('credential-canary-do-not-print')
+            result = self.run_check({'disks': [dict(name='data', path=root, min_free_gib=10**9)],
+                                     'logs': [dict(name='worker', path=str(log), max_mib=0.000001)]})
+        self.assertEqual(result.returncode, 1, result.stderr)
+        self.assertNotIn('credential-canary', result.stdout + result.stderr)
+        self.assertTrue(all(c['status'] == 'warning' for c in json.loads(result.stdout)['checks']))
+
+    def test_cleanup_is_read_only_skips_documents_and_links_and_is_bounded(self):
+        with tempfile.TemporaryDirectory() as root:
+            candidate = Path(root) / 'candidate'
+            candidate.mkdir()
+            (candidate / 'data').write_bytes(b'12345')
+            protected = candidate / 'Documents'
+            protected.mkdir()
+            (protected / 'private').write_bytes(b'123456789')
+            (candidate / 'link').symlink_to(protected, target_is_directory=True)
+            result = self.run_check({'cleanup_candidates': [dict(name='old_cache', path=str(candidate))]})
+            self.assertEqual((candidate / 'data').read_bytes(), b'12345')
+            check = json.loads(result.stdout)['checks'][0]
