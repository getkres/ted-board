+    payload.update(stale=True, stale_since=datetime.fromtimestamp(first, timezone.utc).isoformat(),
+                   last_attempt_at=datetime.fromtimestamp(now, timezone.utc).isoformat())
+    can_write(root, stale_only=True)
+    write_overflow_json(root, payload, stale_only=True)
