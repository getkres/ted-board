+            child = subprocess.Popen([sys.executable, str(SCRIPT), '--inventory', str(fifo)],
+                                     stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+            hung = False
+            try:
+                output, errors = child.communicate(timeout=1)
+            except subprocess.TimeoutExpired:
+                hung = True
+                child.kill()
+                output, errors = child.communicate()
+            self.assertFalse(hung, 'nonregular inventories must fail without blocking')
