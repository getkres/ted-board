+  body.update({k:v for k,v in guards.items() if k in ('expected_section','expected_updated_at') and v is not None})
+  result=call('live_status',**body)
+  if not result.get('ok') or not result.get('card'):raise RuntimeError('Failure handoff was not confirmed')
+  return result['card']
