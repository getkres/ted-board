+  if a.output:write_private(a.output,dict(snapshot=snapshot,result=result))
+  counts={}
+  for action in result['actions']:counts[action['kind']]=counts.get(action['kind'],0)+1
+  print(json.dumps(dict(mode='apply' if apply else 'dry_run',items=len(result['items']),actions=counts,coverage_defects=result['coverage_defects']),sort_keys=True))
