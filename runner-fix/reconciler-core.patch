+  elif c.get('section') in ('up_next','ted_doing') and owner=='ted' and not review and not has_chain:
+   action('dispatch',cid,c.get('updated_at'),dict(card_id=cid))
+ for a in snapshot.get('approvals',[]):
+  if a.get('status') in ('done','failed','superseded','rejected'):continue
+  cid=a.get('card_id');c=cards.get(cid,{})
+  start=stamp(a.get('created_at') or a.get('requested_at')) or stamp(c.get('action_started_at') or c.get('created_at') or c.get('updated_at')) or now
+  owner='sebastian' if a.get('status')=='pending' and reserved(c) else 'ted'
+  item('approval:'+str(a['id']),'approval',cid,owner,start,start+6*3600,'approval',summary='exact approval packet requires review')
