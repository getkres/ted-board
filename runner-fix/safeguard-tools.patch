+                self.assertNotIn('canary', result.stdout + result.stderr)
+
+    def test_healthy_expiry_returns_zero(self):
+        result = self.run_check({'expiries': [dict(name='cert', expires_at='2027-10-17T00:00:00Z')]})
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(json.loads(result.stdout)['status'], 'ok')
+
+    def test_fifo_inventory_fails_promptly_without_reading(self):
+        import os
+        with tempfile.TemporaryDirectory() as root:
+            fifo = Path(root).resolve() / 'inventory'
