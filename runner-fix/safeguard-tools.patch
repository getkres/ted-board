+        self.assertNotIn('2027-10-17', result.stdout + result.stderr)
+
+    def test_cleanup_does_not_follow_directory_replaced_by_symlink(self):
+        import importlib.util
+        import os
+        spec = importlib.util.spec_from_file_location('preflight', SCRIPT)
+        module = importlib.util.module_from_spec(spec)
