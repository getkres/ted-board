+            self.assertTrue(check['excluded_entries'])
+            self.assertTrue(json.loads(result.stdout)['dry_run'])
+            limited = self.run_check({'cleanup_candidates': [dict(name='bounded', path=str(candidate), max_entries=1)]})
+            self.assertEqual(json.loads(limited.stdout)['checks'][0]['status'], 'unknown')
+
+    def test_rejects_symlink_and_documents_paths_without_echoing_input(self):
+        with tempfile.TemporaryDirectory() as root:
