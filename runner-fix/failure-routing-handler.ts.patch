+const runnerMessages=new Set(Object.values(failureTemplates.failures).flatMap(base=>Object.values(failureTemplates.recovery).map(suffix=>base+suffix)));
+function runnerFailure(card:any,line:string):boolean {
+  if(card.decision_kind!==null||card.live_state==='waiting_on_you')return false;
+  if(['pending_approval','approval_pending','pending_decision','veto_pending','pending_approval_kinds'].some(k=>Array.isArray(card[k])?card[k].length>0:!!card[k]))return false;
+  for(const key of ['approval','veto']) {
+    if(card[key]&&typeof card[key]==='object'&&!['sent','cancelled','failed','done','superseded'].includes(card[key].status))return false;
+  }
+  const rows=card.messages;
+  if(!Array.isArray(rows)||!rows.length||rows.some(m=>!m||!Number.isFinite(Date.parse(m.at))))return false;
+  const newest=Math.max(...rows.map(m=>Date.parse(m.at)));
+  const latest=rows.filter(m=>Date.parse(m.at)===newest);
+  if(card.live_status_at!=null&&(!Number.isFinite(Date.parse(card.live_status_at))||Date.parse(card.live_status_at)>newest))return false;
+  return latest.length===1&&latest[0].runner_failure===true&&latest[0].who===failureTemplates.author&&latest[0].text===line&&runnerMessages.has(line);
+}
