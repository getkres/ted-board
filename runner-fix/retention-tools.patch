+import json
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+import time
+import unittest
+from unittest import mock
+
+try:
+    from scripts import ops_retention
+except ImportError:
+    ops_retention = None
+
+DAY = 86400
+NOW = 1_900_000_000
+
+
+class RetentionTests(unittest.TestCase):
+    def setUp(self):
+        self.assertIsNotNone(ops_retention, 'retention implementation is missing')
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.root = Path(self.tmp.name).resolve()
+        self.jobs = self.root / 'jobs'
+        self.jobs.mkdir()
+        self.state = self.jobs / 'sessions.json'
+        self.data = dict(sessions={}, approvals={})
+        self.state.write_text(json.dumps(self.data))
+
+    def job(self, cid='sample', status='done', age=100):
+        directory = self.jobs / ('card-' + cid)
+        directory.mkdir()
+        (directory / 'REPORT.md').write_text('LIVE_STATE: done\nLIVE_STATUS: synthetic\n')
+        (directory / 'BRIEF.md').write_text('synthetic')
+        (directory / 'turn.events').write_bytes(b'x' * 20)
+        self.data['sessions'][cid] = dict(status=status, cwd=str(directory), queue=[], pid=None)
+        self.state.write_text(json.dumps(self.data))
+        for path in [*directory.iterdir(), directory]:
+            os.utime(path, (NOW-age*DAY, NOW-age*DAY))
+        return directory
+
+    def report(self, **kwargs):
+        return ops_retention.inventory(self.jobs, self.state, now=NOW, cwds=[], **kwargs)
+
+    def test_old_terminal_directory_is_only_a_review_candidate(self):
+        directory = self.job()
+        before = {str(p): p.read_bytes() for p in directory.iterdir()}
+        report = self.report()
+        self.assertTrue(report['dry_run'])
+        self.assertEqual([(r['kind'], r['path']) for r in report['candidates']],
+                         [('job_directory', 'card-sample')])
+        self.assertTrue(report['candidates'][0]['requires_archive'])
+        self.assertEqual({str(p): p.read_bytes() for p in directory.iterdir()}, before)
+
+    def test_events_can_age_out_while_report_is_preserved(self):
+        directory = self.job(age=40)
+        report = self.report()
+        self.assertEqual([(r['kind'], r['path']) for r in report['candidates']],
+                         [('event_file', 'card-sample/turn.events')])
+        self.assertTrue((directory / 'REPORT.md').exists())
+
+    def test_active_queued_and_pending_approvals_are_excluded(self):
+        self.job('active', 'running')
+        self.job('queued', 'done')
+        self.job('approval', 'done')
+        self.data['sessions']['queued']['queue'] = [dict(id='pending')]
+        self.data['approvals']['a'] = dict(card_id='approval', status='pending')
+        self.state.write_text(json.dumps(self.data))
+        self.assertEqual(self.report()['candidates'], [])
+
+    def test_blocked_report_and_approval_artifacts_are_preserved(self):
+        a = self.job('blocked')
+        b = self.job('draft')
+        (a / 'REPORT.md').write_text('LIVE_STATE: blocked\nLIVE_STATUS: pending pr\n')
+        (b / 'apply.sql').write_text('synthetic, never executed')
+        self.assertEqual(self.report()['candidates'], [])
+
+    def test_unknown_owner_and_live_cwd_are_preserved(self):
+        directory = self.job()
+        self.assertEqual(ops_retention.inventory(self.jobs, self.state, now=NOW,
+                                                cwds=[directory])['candidates'], [])
+        self.data['sessions'] = {}
+        self.state.write_text(json.dumps(self.data))
+        self.assertEqual(self.report()['candidates'], [])
+
+    def test_symlinks_and_protected_subtrees_are_never_followed(self):
+        directory = self.job()
+        (directory / 'alias.events').symlink_to(self.root / 'absent')
+        protected = directory / 'Documents'
+        protected.mkdir()
+        (protected / 'keep').write_text('private-sentinel')
+        report = self.report()
+        self.assertFalse(any(row['kind']=='job_directory' for row in report['candidates']))
+        self.assertNotIn('private-sentinel', json.dumps(report))
+        self.assertNotIn('Documents/keep', json.dumps(report))
+
+    def test_scan_budget_marks_incomplete_and_never_guesses_total(self):
+        self.job()
+        report = self.report(max_entries=2)
+        self.assertFalse(report['complete'])
+        self.assertEqual(report['candidates'], [])
+
+    def test_worktrees_require_clean_merged_inactive_and_old(self):
+        repo = self.root / 'repo'
+        repo.mkdir()
+        def git(*args):
+            return subprocess.run(['git', '-C', str(repo), *args], check=True, capture_output=True)
+        git('init', '-b', 'main')
+        git('config', 'user.name', 'Fixture')
+        git('config', 'user.email', 'fixture@example.invalid')
+        (repo / 'source').write_text('baseline')
+        git('add', 'source')
+        git('commit', '-m', 'fixture')
+        tree = self.root / 'trees/old'
+        tree.parent.mkdir()
+        git('worktree', 'add', '-b', 'completed', str(tree))
+        for path in [*tree.iterdir(), tree]:
+            os.utime(path, (NOW-100*DAY, NOW-100*DAY))
+        report = self.report(repos=[repo], worktree_roots=[tree.parent], merged_ref='refs/heads/main')
+        self.assertEqual([r['kind'] for r in report['candidates']], ['worktree'])
+        (tree / 'source').write_text('uncommitted work')
+        self.assertEqual(self.report(repos=[repo], worktree_roots=[tree.parent],
+                                     merged_ref='refs/heads/main')['candidates'], [])
+
+    def test_claim_lock_prevents_retention(self):
+        import fcntl
+        directory = self.job()
+        with (directory / 'turn.claim').open('a') as stream:
+            fcntl.flock(stream, fcntl.LOCK_EX | fcntl.LOCK_NB)
+            self.assertEqual(self.report()['candidates'], [])
+
+    def test_heartbeat_text_change_does_not_invalidate_unchanged_ownership(self):
+        self.job()
+        changed = json.loads(json.dumps(self.data))
+        changed['sessions']['sample']['last_line'] = 'heartbeat changed'
+        read = ops_retention.read_regular
+        calls = 0
+        def reading(path, limit):
+            nonlocal calls
+            if path == self.state:
+                calls += 1
+                if calls > 1:
+                    return json.dumps(changed).encode()
+            return read(path, limit)
+        with mock.patch.object(ops_retention, 'read_regular', reading):
+            report = self.report()
+        self.assertTrue(report['complete'])
+        self.assertEqual(len(report['candidates']), 1)
+
+    def test_new_queued_work_invalidates_snapshot(self):
+        self.job()
+        changed = json.loads(json.dumps(self.data))
+        changed['sessions']['sample']['queue'] = [dict(id='new')]
+        read = ops_retention.read_regular
+        calls = 0
+        def reading(path, limit):
+            nonlocal calls
+            if path == self.state:
+                calls += 1
+                if calls > 1:
+                    return json.dumps(changed).encode()
+            return read(path, limit)
+        with mock.patch.object(ops_retention, 'read_regular', reading):
+            report = self.report()
+        self.assertFalse(report['complete'])
+        self.assertEqual(report['candidates'], [])
+
+    def test_large_report_requires_only_its_state_prefix(self):
+        directory = self.job()
+        (directory / 'REPORT.md').write_text('LIVE_STATE: done\nLIVE_STATUS: synthetic\n' + 'x' * 140_000)
+        for path in [directory/'REPORT.md', directory]:
+            os.utime(path, (NOW-100*DAY, NOW-100*DAY))
+        self.assertTrue(self.report()['complete'])
+
+    def test_missing_report_is_a_retained_outcome_not_a_failed_scan(self):
+        directory = self.job()
+        (directory/'REPORT.md').unlink()
+        report = self.report()
+        self.assertTrue(report['complete'])
+        self.assertEqual(report['candidates'], [])
+
+
+if __name__ == '__main__':
+    unittest.main()
