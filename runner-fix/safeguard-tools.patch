+                result = self.run_check({'heartbeats': [dict(name='worker', path=path, max_age_seconds=600)]})
+                self.assertEqual(result.returncode, 2)
+                self.assertNotIn(root, result.stdout + result.stderr)
+                self.assertNotIn('secret-canary', result.stdout + result.stderr)
+
+    def test_empty_malformed_or_unaware_inventory_cannot_pass(self):
