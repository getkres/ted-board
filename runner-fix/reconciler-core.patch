+"""Pure, level-triggered planner. No I/O, clocks, credentials, or model calls."""
+import hashlib
+import json
+import re
+from datetime import datetime, timezone
+
+RETRY_LIMIT=2
+LEASE_SECONDS=150
+RESERVED={'spend_money','send_email','contracts','legal','pricing','database_write','approve_design','your_words','his_copy'}
+TERMINAL={'done','killed','closed','verified'}
+
+
+def stamp(value):
+ if isinstance(value,(int,float)) and not isinstance(value,bool):return float(value)
+ if not isinstance(value,str):return 0
+ try:return datetime.fromisoformat(value.replace('Z','+00:00')).timestamp()
+ except (ValueError,TypeError,OverflowError):return 0
+
+
+def iso(value):return datetime.fromtimestamp(value,timezone.utc).isoformat().replace('+00:00','Z')
+
+def digest(*parts):return hashlib.sha256(json.dumps(parts,sort_keys=True,default=str).encode()).hexdigest()[:24]
+
+def reserved(card):
+ if 'inbox_decision' in card:return card['inbox_decision'] in {'send_email','spend_money','legal','pricing','prod_write','copy','approve_design'}
+ kind=card.get('decision_kind')
+ if kind=='approve_design':return bool(card.get('fresh_mockup_batch') or card.get('mockup_batch'))
+ return kind in RESERVED
+
+
+def priority_key(card):
+ value=card.get('priority_class')
+ priority=0 if value=='urgent' or card.get('explicit_ask') is True else 1 if value in ('launch','revenue','client_revenue') else 2
+ return priority,stamp(card.get('action_started_at') or card.get('created_at')) or stamp(card.get('updated_at')),str(card.get('id',''))
+
+
+def classify_priorities(snapshot,overrides):
+ for c in snapshot['cards']:
+  metadata=c.get('metadata') if isinstance(c.get('metadata'),dict) else {}
+  if 'priority_class' not in c and metadata.get('priority_class'):c['priority_class']=metadata['priority_class']
+  if 'explicit_ask' not in c and 'explicit_ask' in metadata:c['explicit_ask']=metadata['explicit_ask']
+  messages=[m for m in c.get('messages',[]) if isinstance(m,dict) and stamp(m.get('at'))]
+  latest=max(messages,key=lambda m:stamp(m.get('at')),default={})
+  if 'explicit_ask' not in c and latest.get('who') in ('seb','sebastian'):c['explicit_ask']=True
+  if 'priority_class' not in c:
+   text=(str(c.get('title',''))+' '+str(c.get('body',''))).lower()
+   if re.search(r'\b(?:launch|client revenue|revenue launch)\b',text):c['priority_class']='launch'
+  if not c.get('created_at') and messages:c['created_at']=min(messages,key=lambda m:stamp(m.get('at')))['at']
+  override=overrides.get(c['id'],{})
+  if isinstance(override,dict):
+   if override.get('priority_class') in ('urgent','launch','revenue','client_revenue','ordinary'):c['priority_class']=override['priority_class']
+   if type(override.get('explicit_ask')) is bool:c['explicit_ask']=override['explicit_ask']
+  c.setdefault('priority_class','ordinary');c.setdefault('explicit_ask',False)
+
+
+def unsafe_session(s):
+ turn=s.get('active_turn') or {}
+ return bool(s.get('reviewing') or s.get('active_veto_revision') is not None or s.get('side_effecting') or s.get('veto_outcome') or turn.get('kind')=='review' or turn.get('veto_proposal_id') or turn.get('side_effecting'))
+
+
+def backoff(entity,attempt):
+ base=min(3300,60*2**min(max(attempt-1,0),6))
+ return min(3600,base+int(digest(entity,attempt)[:4],16)%max(1,base//4))
+
+
+def evidenced_stage(snapshot,cid,now=None):
+ w=snapshot.get('workflows',{}).get(cid,{})
+ pr=snapshot.get('prs',{}).get(w.get('pr_url'),{})
+ if pr.get('state')!='MERGED':return 'pr' if w.get('pr_url') else 'build'
+ d=w.get('deployment',{});v=w.get('verification',{})
+ merged=stamp(pr.get('merged_at'));deployed=stamp(d.get('deployed_at'));verified=stamp(v.get('verified_at'));revision=pr.get('merge_revision')
+ if not (d.get('verified') is True and deployed and revision and d.get('revision')==revision and deployed>=merged and (now is None or deployed<=now)):return 'merged'
+ if v.get('ok') is True and verified>=deployed and (now is None or verified<=now) and v.get('revision')==revision:return 'verified'
+ return 'deployed'
+
+
+def workflow_stage(snapshot,cid,now=None):
+ observed=evidenced_stage(snapshot,cid,now)
+ c=next((c for c in snapshot['cards'] if c.get('id')==cid),{})
+ previous=c.get('reconciliation_stage') or snapshot.get('workflows',{}).get(cid,{}).get('last_stage')
+ rank={'build':0,'pr':1,'merged':2,'deployed':3,'verified':4}
+ return previous if rank.get(previous,-1)>rank[observed] else observed
+
+
