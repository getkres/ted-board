+def mark_stale(root, now):
+    path = Path(root) / 'steward-overflow.json'
+    try:
+        payload = json.loads(path.read_text())
+        if not isinstance(payload, dict):
+            raise ValueError('Invalid cached overflow')
+    except (OSError, ValueError):
+        payload = dict(at=None, needs_you=None, cap=12, excess_count=None,
+                       extras=[], ranked=[], ambiguous=[])
