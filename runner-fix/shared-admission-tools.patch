+#!/usr/bin/env python3
+"""One host-local resource gate for cooperating model and scheduled commands."""
+import argparse
+import contextlib
+import fcntl
+import json
+import math
+import os
+from pathlib import Path
+import re
+import signal
+import stat
+import subprocess
+import sys
+import time
+import uuid
+
+DEFAULT_ROOT = Path.home() / 'ted-ops/state/shared-admission'
+GIB = 1024 ** 3
+LANES = {'board', 'direct', 'launchd'}
+MEMORY_PER_RUN = 2 * GIB
+CPU_PER_RUN = 1.0
+
+
+class Deferred(Exception):
+    """Admission refused; the caller must preserve its queued work."""
+
+
+def parse_vm_stat(text):
+    page = re.search(r'page size of (\d+) bytes', text)
+    if not page:
+        raise ValueError('unknown page size')
+    counts = []
+    for label in ('free', 'inactive', 'speculative'):
+        row = re.search(r'^Pages ' + label + r':\s+(\d+)\.', text, re.M)
+        if not row:
+            raise ValueError('unknown memory counter')
+        counts.append(int(row[1]))
+    return int(page[1]) * sum(counts)
+
+
+def command_output(command):
+    return subprocess.run(command, capture_output=True, text=True, check=True, timeout=10).stdout
+
+
+def pressure():
+    if sys.platform == 'darwin':
+        total = int(command_output(['/usr/sbin/sysctl', '-n', 'hw.memsize']).strip())
+        available = parse_vm_stat(command_output(['/usr/bin/vm_stat']))
+    elif sys.platform.startswith('linux'):
+        memory = dict(re.findall(r'^(MemTotal|MemAvailable):\s+(\d+) kB$',
+                                 Path('/proc/meminfo').read_text(), re.M))
+        total, available = int(memory['MemTotal']) * 1024, int(memory['MemAvailable']) * 1024
+    else:
+        raise ValueError('unsupported pressure source')
+    return dict(cores=os.cpu_count(), load=os.getloadavg()[0],
+                available_bytes=available, total_bytes=total)
+
+
+def processes():
+    # No command arguments or environment values enter the state or output.
+    output = command_output(['/bin/ps', '-axo', 'pid=,pgid=,stat=,lstart='])
+    table = {}
+    for line in output.splitlines():
+        fields = line.split(None, 3)
+        if len(fields) != 4:
+            raise ValueError('unknown process identity')
+        pid, pgid, status, started = fields
+        if not status.startswith('Z'):
+            table[int(pid)] = dict(pgid=int(pgid), identity=started.strip())
+    if os.getpid() not in table:
+        raise ValueError('incomplete process evidence')
+    return table
+
+
+def validate_pressure(sample):
+    for name in ('cores', 'load', 'available_bytes', 'total_bytes'):
+        value = sample[name]
+        if type(value) not in (int, float) or not math.isfinite(value) or value < 0:
+            raise ValueError('unknown pressure')
+    if sample['cores'] < 1 or sample['total_bytes'] < 1 or sample['available_bytes'] > sample['total_bytes']:
+        raise ValueError('invalid pressure')
+
+
+class Gate:
+    def __init__(self, root=DEFAULT_ROOT, *, sample=pressure):
+        self.root = Path(root).absolute()
+        self.sample = sample
+
+    @contextlib.contextmanager
+    def locked(self):
+        # Parent locations are operator-owned. Refuse custom aliases before resolving.
+        for part in [*reversed(self.root.parents), self.root]:
+            alias = part in (Path('/var'), Path('/tmp')) and part.resolve() == Path('/private') / part.name
+            if part.is_symlink() and not alias:
+                raise ValueError('symlink state directory')
+        # Traverse from a held root descriptor, so a concurrent replacement cannot
+        # redirect resolve(), mkdir(), or the state files through a symlink.
+        path = self.root
+        if len(path.parts) > 1 and path.parts[1] in ('var', 'tmp') and Path('/'+path.parts[1]).is_symlink():
+            path = Path('/private').joinpath(*path.parts[1:])
+        directory = os.open('/', os.O_RDONLY | os.O_DIRECTORY)
+        try:
+            for component in path.parts[1:]:
+                try:
+                    next_fd = os.open(component, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=directory)
+                except FileNotFoundError:
+                    try:
+                        os.mkdir(component, mode=0o700, dir_fd=directory)
+                    except FileExistsError:
+                        pass
+                    next_fd = os.open(component, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=directory)
+                os.close(directory)
+                directory = next_fd
+        except BaseException:
+            os.close(directory)
+            raise
+        try:
+            info = os.fstat(directory)
+            if info.st_uid != os.getuid() or info.st_mode & 0o077:
+                raise ValueError('private state directory required')
+            lock = os.open('gate.lock', os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK,
+                           0o600, dir_fd=directory)
+            try:
+                self.private_file(lock)
+                os.fchmod(lock, 0o600)
+                fcntl.flock(lock, fcntl.LOCK_EX)
+                yield directory
+            finally:
+                os.close(lock)
+        finally:
+            os.close(directory)
+
+    @staticmethod
+    def private_file(fd):
+        info = os.fstat(fd)
+        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_uid != os.getuid():
+            raise ValueError('private regular state required')
+
+    def read(self, directory):
+        try:
+            fd = os.open('leases.json', os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=directory)
+        except FileNotFoundError:
+            return []
+        with os.fdopen(fd, 'rb') as stream:
+            self.private_file(stream.fileno())
+            raw = stream.read(1_048_577)
+        if len(raw) > 1_048_576:
+            raise ValueError('state too large')
+        data = json.loads(raw)
+        if data.get('version') != 1 or not isinstance(data.get('leases'), list):
+            raise ValueError('invalid state')
+        for row in data['leases']:
+            if not isinstance(row, dict) or row.get('lane') not in LANES:
+                raise ValueError('invalid lease')
+            if type(row.get('pgid')) is not int or row['pgid'] <= 1 or not isinstance(row.get('identity'), str):
+                raise ValueError('invalid process identity')
+            if not isinstance(row.get('token'), str) or not re.fullmatch(r'[a-f0-9]{32}', row['token']):
+                raise ValueError('invalid lease token')
+            if row.get('memory_bytes') != MEMORY_PER_RUN or row.get('cpu') != CPU_PER_RUN:
+                raise ValueError('incompatible lease policy')
+        return data['leases']
+
+    @staticmethod
+    def write(directory, leases):
+        name = 'leases.' + uuid.uuid4().hex + '.tmp'
+        fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=directory)
+        try:
+            with os.fdopen(fd, 'w') as stream:
+                json.dump(dict(version=1, leases=leases), stream, sort_keys=True)
+                stream.flush()
+                os.fsync(stream.fileno())
+            os.replace(name, 'leases.json', src_dir_fd=directory, dst_dir_fd=directory)
+            os.fsync(directory)
+        finally:
+            try:
+                os.unlink(name, dir_fd=directory)
+            except FileNotFoundError:
+                pass
+
+    def spawn(self, command, *, lane, **kwargs):
+        if lane not in LANES or not command:
+            raise ValueError('valid lane and command required')
+        if kwargs.pop('start_new_session', True) is not True:
+            raise ValueError('dedicated process group required')
+        child = None
+        try:
+            with self.locked() as directory:
+                leases = self.read(directory)
+                table = processes()
+                groups = {p['pgid'] for p in table.values()}
+                # Keep surviving group members even after their leader exits.
+                leases = [row for row in leases if row['pgid'] in groups]
+                sample = self.sample()
+                validate_pressure(sample)
+                if sample['load'] + sum(row['cpu'] for row in leases) + CPU_PER_RUN > 2 * sample['cores']:
+                    raise Deferred('load budget')
+                floor = max(4 * GIB, .10 * sample['total_bytes'])
+                if sample['available_bytes'] - sum(row['memory_bytes'] for row in leases) - MEMORY_PER_RUN < floor:
+                    raise Deferred('memory budget')
+                token = uuid.uuid4().hex
+                guarded = [sys.executable, str(Path(__file__).resolve()), '_child', '--state-dir', str(self.root),
+                           '--token', token, '--', *map(str, command)]
+                child = subprocess.Popen(guarded, start_new_session=True, **kwargs)
+                owner = processes().get(child.pid)
+                if not owner or owner['pgid'] != child.pid:
+                    raise ValueError('unverified child')
+                leases.append(dict(token=token, lane=lane, pgid=child.pid, identity=owner['identity'],
+                                   memory_bytes=MEMORY_PER_RUN, cpu=CPU_PER_RUN))
+                self.write(directory, leases)
+            return child
+        except Exception as exc:
+            # The child waits on this same lock and cannot exec an uncommitted lease.
+            if child is not None and child.poll() is None:
+                try:
+                    os.killpg(child.pid, signal.SIGTERM)
+                except ProcessLookupError:
+                    pass
+                child.wait(timeout=10)
+            if isinstance(exc, Deferred):
+                raise
+            raise Deferred('admission evidence unavailable') from None
+
+    def authorize_child(self, token):
+        with self.locked() as directory:
+            owner = processes().get(os.getpid())
+            return bool(owner and any(row['token'] == token and row['pgid'] == os.getpid()
+                                      and row['identity'] == owner['identity']
+                                      for row in self.read(directory)))
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('action', choices=('run', '_child', 'status'))
+    parser.add_argument('--lane', choices=sorted(LANES), default='direct')
+    parser.add_argument('--state-dir', type=Path, default=DEFAULT_ROOT,
+                        help='use the default on the mini; overrides are for isolated tests')
+    parser.add_argument('--token', default='')
+    # Parse gate options separately from the command, preserving literal arguments.
+    values = list(sys.argv[1:] if argv is None else argv)
+    index = values.index('--') if '--' in values else len(values)
+    args = parser.parse_args(values[:index])
+    command = values[index + 1:]
+    gate = Gate(args.state_dir)
+    try:
+        if args.action == 'status':
+            sample = pressure()
+            validate_pressure(sample)
+            print(json.dumps(sample, sort_keys=True))
+            return 0
+        if not command:
+            raise ValueError('command required')
+        if args.action == '_child':
+            if not gate.authorize_child(args.token):
+                return 75
+            os.execvpe(command[0], command, dict(os.environ))
+        child = gate.spawn(command, lane=args.lane)
+        def forward(signum, frame):
+            try:
+                os.killpg(child.pid, signum)
+            except ProcessLookupError:
+                pass
+        for signum in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
+            signal.signal(signum, forward)
+        result = child.wait()
+        return result if result >= 0 else 128 - result
+    except (Deferred, OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError):
+        print('admission deferred; command did not complete', file=sys.stderr)
+        return 75
+
+
+if __name__ == '__main__':
+    sys.exit(main())
