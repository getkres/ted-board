+"""Opt-in bounded JSONL writer for sanitized operational records, on Unix hosts."""
+import fcntl
+import json
+import logging
+from logging.handlers import RotatingFileHandler
+import os
+from pathlib import Path
+import stat
+
+from scripts.ops_preflight import safe_path
+
+
+def private_regular(path):
+    if path.is_symlink():
+        raise ValueError('symlink refused')
+    try:
+        info = path.stat()
+    except FileNotFoundError:
+        return
+    if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
+        raise ValueError('private regular file required')
+
+
+class PrivateHandler(RotatingFileHandler):
+    def _open(self):
+        descriptor = os.open(self.baseFilename, os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW, 0o600)
+        os.fchmod(descriptor, 0o600)
+        return os.fdopen(descriptor, 'a', encoding='utf-8')
+
+    def handleError(self, record):
+        # The stdlib default prints record contents to stderr and swallows I/O errors.
+        raise OSError('bounded log write failed') from None
+
+
+def append_rows(path, rows, *, max_bytes=5_000_000, backups=3):
+    """Append sanitized dicts, retaining at most (backups + 1) * max_bytes bytes.
+
+    All writers to this path must use this helper. Existing append-only writers
+    and processes holding old descriptors must be migrated before enabling it.
+    The parent directory must already exist and be private to the operator.
+    """
+    if type(max_bytes) is not int or max_bytes < 1 or type(backups) is not int or not 1 <= backups <= 100:
+        raise ValueError('positive size and 1 to 100 backups required')
+    path = safe_path(str(path))
+    lines = []
+    for row in rows:
+        if not isinstance(row, dict):
+            raise ValueError('JSON objects required')
+        line = json.dumps(row, sort_keys=True, ensure_ascii=True, allow_nan=False)
+        if len((line + '\n').encode('utf-8')) > max_bytes:
+            raise ValueError('record exceeds log budget')
+        lines.append(line)
+    lock = path.with_name(path.name + '.lock')
+    private_regular(lock)
+    descriptor = os.open(lock, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
+    with os.fdopen(descriptor, 'a') as stream:
+        os.fchmod(stream.fileno(), 0o600)
+        fcntl.flock(stream, fcntl.LOCK_EX)
+        allowed = {path.name + '.' + str(i) for i in range(1, backups + 1)}
+        with os.scandir(path.parent) as siblings:
+            for sibling in siblings:
+                suffix = sibling.name.removeprefix(path.name + '.')
+                if sibling.name.startswith(path.name + '.') and suffix.isdecimal() and sibling.name not in allowed:
+                    raise ValueError('preserve archives outside the retention policy first')
+        for target in [path] + [path.with_name(path.name + '.' + str(i)) for i in range(1, backups + 1)]:
+            private_regular(target)
+            if target.exists():
+                if target.stat().st_size > max_bytes:
+                    raise ValueError('preserve oversized logs before enabling rotation')
+                target.chmod(0o600)
+        handler = PrivateHandler(path, maxBytes=max_bytes, backupCount=backups, encoding='utf-8')
+        handler.setFormatter(logging.Formatter('%(message)s'))
+        try:
+            for line in lines:
+                record = logging.LogRecord('bounded-json', logging.INFO, '', 0, line, (), None)
+                handler.emit(record)
+            handler.flush()
+        finally:
+            handler.close()
