@@ -34,0 +42,32 @@
+
+
+# Auto-routing is an allow decision. Every ambiguity check must pass first.
+REPORT_ADDRESS_WORDS = frozenset({'you', 'your', 'yours', 'yourself', 'sebastian'})
+REPORT_CHOICE_PREFIXES = ('pick', 'favorit', 'favourit', 'prefer', 'like', 'liking',
+                          'option', 'approv', 'agre', 'thought', 'signoff')
+REPORT_MONEY_PREFIXES = ('pric', 'budget', 'spend', 'spent')
+COMPLETION = re.compile('(?:'+REPORT.pattern+r'|\bcompleted\b)', re.I)
+
+
+def positive_completion(text, pattern=COMPLETION):
+    negated = list(NEGATED_REPORT.finditer(text))
+    return any(not any(n.start() <= match.start() < n.end() for n in negated)
+               for match in pattern.finditer(text))
+
+
+def report_only_reason(text):
+    """Return a hold reason unless the entire message satisfies report-only policy."""
+    words = tuple(re.findall(r'[a-z]+', text.casefold()))
+    pairs = set(zip(words, words[1:]))
+    if set(words) & REPORT_ADDRESS_WORDS:
+        return 'report addresses sebastian or the reader, ted judgment required'
+    if '?' in text or chr(0xff1f) in text:
+        return 'report contains a question, ted judgment required'
+    if any(word.startswith(REPORT_CHOICE_PREFIXES) for word in words) or ('sign', 'off') in pairs:
+        return 'report contains choice or approval language, ted judgment required'
+    if (any(word.startswith(REPORT_MONEY_PREFIXES) for word in words)
+            or 'monthly' in words or ('per', 'day') in pairs or re.search(r'\$\s*\d', text)):
+        return 'report contains money or pricing language, ted judgment required'
+    if not positive_completion(text):
+        return 'no unambiguous completion evidence, ted judgment required'
+    return None
