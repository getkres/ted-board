+def sample_health(store,now):
+ """Probe processes and file activity outside the renewal lock, then CAS observations."""
+ from sessions import alive
+ with store.locked() as data:sessions=json.loads(json.dumps(data['sessions']))
+ updates={}
+ for cid,session in sessions.items():
+  if session.get('status')!='running' or not session.get('lease_token'):continue
+  pid_dead=not alive(session.get('pid'),session.get('identity'))
+  activity=activity_stamp(session)
+  quiet=activity==session.get('health_activity_mtime',0) and now-activity>=150
+  expired=stamp(session.get('lease_expires_at'))<=now
+  signature=[session.get('lease_token'),session.get('lease_expires_at'),session.get('lease',{}).get('renewed_at')]
+  same=signature==session.get('health_lease')
+  misses=int(session.get('missed_renewals') or 0) if same else 0
+  if expired and pid_dead and quiet:
+   if now-stamp(session.get('health_observed_at'))>=30:misses+=1
+  else:misses=0
+  update=dict(pid_dead=pid_dead,activity_quiet=quiet,missed_renewals=misses,health_activity_mtime=activity,health_lease=signature,health_observed_at=now)
+  with store.locked() as data:
+   current=data['sessions'].get(cid,{})
+   if all(current.get(k)==session.get(k) for k in ('turn','lease_token','lease_expires_at','status')):
+    current.update(update);updates[cid]=dict(current)
+ return updates
