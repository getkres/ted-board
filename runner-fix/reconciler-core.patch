+   if stage=='deployed' and not evidence_gap:action('advance_verify',cid,snapshot['workflows'][cid]['deployment'],dict(card_id=cid,stage='verify'))
+   if stage=='verified':
+    v=snapshot['workflows'][cid].get('verification',{})
+    active=s.get('status') in ('running','queued') or bool(s.get('queue'))
+    if not active and s.get('status')!='failed' and c.get('revision') is not None and v.get('card_revision')==c.get('revision') and snapshot.get('prs',{}).get(snapshot['workflows'][cid].get('pr_url'),{}).get('state')=='MERGED':
+     action('close_verified',cid,v,dict(card_id=cid))
+    else:
