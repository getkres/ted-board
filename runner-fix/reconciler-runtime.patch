+def main(argv=None):
+ p=argparse.ArgumentParser(description=__doc__);p.add_argument('--root',type=Path,default=Path.home()/'ted-ops/ted-board');p.add_argument('--snapshot',type=Path);p.add_argument('--output',type=Path);p.add_argument('--dry-run',action='store_true');p.add_argument('--apply',action='store_true');p.add_argument('--policy-source',type=Path);p.add_argument('--redrive');p.add_argument('--reason');a=p.parse_args(argv)
+ apply=a.apply and not a.dry_run
+ if a.apply and a.dry_run:p.error('choose dry-run or apply')
+ from runner_admission import reconciler_enabled
+ if apply and (not reconciler_enabled(a.root/'jobs/reconciler-config.json') or 'mini' not in socket.gethostname().lower()):p.error('apply requires mini and explicit reviewed enablement')
+ if apply and (a.snapshot or a.policy_source):p.error('apply must observe fresh installed sources')
+ root=a.root.resolve();sys.path.insert(0,str(root))
+ lock=None
+ if apply:
