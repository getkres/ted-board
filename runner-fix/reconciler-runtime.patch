+#!/usr/bin/env python3
+"""Private mini adapter. Default dry-run performs GETs and local reads only."""
+import argparse
+from concurrent.futures import ThreadPoolExecutor
+import contextlib
+import fcntl
+import importlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import re
+import socket
+import sqlite3
+import subprocess
+import sys
+import time
+import uuid
+
+from reconciler import classify_priorities, digest, iso, plan, stamp, unsafe_session
+
+PR=re.compile(r'https://github\.com/([A-Za-z0-9_.-]+)/([A-Za-z0-9_.-]+)/pull/(\d+)\b')
+
+
+def read_json(path,default):
+ try:
+  path=Path(path)
+  if path.is_symlink() or path.stat().st_size>16*1024*1024:return default
+  return json.loads(path.read_text())
+ except (OSError,ValueError):return default
+
+
+class Journal:
+ def __init__(self,path):self.path=Path(path)
+ def __enter__(self):
+  self.path.parent.mkdir(parents=True,exist_ok=True)
+  self.db=sqlite3.connect(self.path);os.chmod(self.path,0o600)
+  self.db.execute('pragma synchronous=FULL')
+  self.db.execute('create table if not exists receipts (id text primary key, kind text not null, completed_at real not null)');self.db.commit();return self
+ def __exit__(self,*args):self.db.close()
+ def completed(self):return {row[0] for row in self.db.execute('select id from receipts')}
+ def complete(self,aid,action):
+  self.db.execute('insert or ignore into receipts values (?,?,?)',(aid,action['kind'],time.time()));self.db.commit()
+
+
+def completed_readonly(path):
+ if not Path(path).exists():return set()
+ db=sqlite3.connect(Path(path).resolve().as_uri()+'?mode=ro',uri=True)
+ try:return {row[0] for row in db.execute('select id from receipts')}
+ finally:db.close()
+
+
+def execute_recorded(action,journal,effect):
+ if action['id'] in journal.completed():return True
+ if effect(action) is not True:return False
+ journal.complete(action['id'],action);return True
+
+
+def recover_session(session,action,stop):
+ p=action['payload']
+ if session.get('turn')!=p.get('expected_turn') or session.get('lease_token')!=p.get('expected_lease_token'):return False
+ if session.get('recovery_action')==action['id']:return False
+ if action['kind']=='retry' and unsafe_session(session):return False
+ if not stop(session):return False
+ old=dict(session.get('active_turn') or {})
+ session.update(pid=None,identity='',recovery_action=action['id'],recovery_required=None)
+ remaining=list(session.get('queue') or [])
+ session['queue']=remaining
+ if action['kind']=='dead_letter':
+  session.update(status='dead_letter',last_line='retry exhausted or unsafe to repeat, ted review required',dead_letter_at=time.time())
+  return True
+ session['retry_count']=p['attempt'];session['retry_at']=stamp(p['retry_at'])
+ session['queue']=[dict(id='reconciler-retry-'+action['id'],kind='work',message='Resume from REPORT.md and your files. Verify prior effects before continuing. '+old.get('message','')[:12000])]+remaining
+ session.update(status='queued',last_line='safe retry queued with backoff')
+ return True
+
+
+def redrive(session,reason):
+ if not isinstance(reason,str) or not reason.strip() or len(reason)>240:raise ValueError('Ted redrive requires a short repair reason')
+ if session.get('status')!='dead_letter':raise ValueError('Only dead-lettered work can be redriven')
+ if unsafe_session(session):raise ValueError('Side effects require their original approval flow')
+ session.setdefault('redrive_history',[]).append(dict(at=time.time(),reason=reason,retry_count=session.get('retry_count',0)))
+ session.update(status='queued',retry_count=0,retry_at=0,recovery_action=None)
+ session['queue']=[dict(id='redrive-'+uuid.uuid4().hex,kind='work',message='Ted redrive after repair: '+reason+'. Resume from REPORT.md and files, and verify existing effects first.')]+list(session.get('queue') or [])
+
+
+def local_snapshot(root,cards):
+ root=Path(root);path=root/'jobs/sessions.json'
+ # Atomic replacement gives a complete old or new document. No Store.read(),
+ # which writes on lock exit, is permitted in dry-run.
+ data=read_json(path,None)
+ if not isinstance(data,dict) or not isinstance(data.get('sessions'),dict):raise RuntimeError('Session store unavailable')
+ workflows={};sessions=data['sessions']
+ for c in cards:
+  cid=c['id'];s=sessions.get(cid,{})
+  directory=Path(s.get('cwd') or root/'jobs'/('card-'+cid))
+  if s.get('turn'):
+   result=read_json(directory/(str(s['turn'])+'.result.json'),None)
+   if isinstance(result,dict) and isinstance(result.get('ok'),bool):
+    if s.get('lease_token'):
+     s['result_ready']=all(result.get(k)==v for k,v in dict(lease_token=s['lease_token'],turn=s['turn'],pid=s.get('pid'),identity=s.get('identity')).items())
+    else:s['result_ready']=True
+  w=read_json(directory/'workflow.json',{})
+  if not isinstance(w,dict):w={}
+  w={k:w[k] for k in ('pr_url','deployment','verification','created_at','review_required') if k in w}
+  report=directory/'REPORT.md';text=''
+  if report.is_file() and not report.is_symlink() and report.stat().st_size<=100000:text=report.read_text()
+  matches=list(PR.finditer(text))
+  if 'pr_url' not in w and matches:w['pr_url']=matches[-1].group(0)
+  if (directory/'apply.sql').is_file() and not (directory/'applied-receipt.json').is_file():w['sql_pending']=True
+  if re.search(r'needs ted review|pending review|pr pending|not (?:merged|deployed|live)|ted review',text,re.I):w['review_required']=True
+  if w:workflows[cid]=w
+ approvals=data.get('approvals',{})
+ return dict(cards=cards,sessions=sessions,approvals=list(approvals.values()) if isinstance(approvals,dict) else approvals,workflows=workflows,prs={},mockups=[],coverage={'cards':'ok','sessions':'ok','approvals':'ok'})
+
+
+def pr_observation(url):
+ m=PR.fullmatch(url or '')
+ if not m:return url,None
+ try:
+  result=subprocess.run(['gh','pr','view',m[3],'--repo',m[1]+'/'+m[2],'--json','state,mergedAt,createdAt,headRefOid,mergeCommit,url'],capture_output=True,text=True,timeout=20)
+  if result.returncode:return url,None
+  data=json.loads(result.stdout)
+  return url,dict(state=data['state'],merged_at=data.get('mergedAt'),created_at=data.get('createdAt'),revision=data.get('headRefOid'),merge_revision=(data.get('mergeCommit') or {}).get('oid'))
+ except (OSError,ValueError,KeyError,subprocess.TimeoutExpired):return url,None
+
+
+def observe(root,board=None,mockups=None,policy_source=None):
+ sys.path.insert(0,str(root))
+ board=board or importlib.import_module('board_client')
+ feed=board.call()
+ cards=feed.get('cards') if isinstance(feed,dict) else None
+ if not isinstance(cards,list) or len(cards)>=500:raise RuntimeError('Complete card feed unavailable')
+ s=local_snapshot(root,cards)
+ try:
+  feed=(mockups or importlib.import_module('mockup_client')).call()
+  rows=feed.get('mockups')
+  if not isinstance(rows,list):raise ValueError()
+  s['mockups']=rows;s['coverage']['mockups']='ok'
+ except Exception:s['coverage']['mockups']='unavailable'
+ try:
+  if policy_source:
+   spec=importlib.util.spec_from_file_location('reconciler_inbox_policy',policy_source);policy=importlib.util.module_from_spec(spec);spec.loader.exec_module(policy)
+  else:policy=importlib.import_module('inbox_policy')
+  for c in s['cards']:
+   if s['coverage'].get('mockups')!='ok' and re.search(r'\b(?:mockup|design|batch|pick|choose|copy)\b',policy.current_text(c),re.I) and not policy.failure_kind(policy.current_text(c)):
+    c['classification_uncertain']=True
+   else:c['inbox_decision']=policy.decision(c,mockups=s['mockups'])
+  s['coverage']['inbox_policy']='ok'
+ except Exception:s['coverage']['inbox_policy']='not_installed'
+ try:
+  remote=board.call(resource='jobs')
+  if not isinstance(remote.get('jobs'),list):raise ValueError()
+  s['coverage']['remote_jobs']='ok'
+  s['external_jobs']=[j for j in remote['jobs'] if j.get('id')!='fresh-ted-health' and j.get('status') in ('running','queued','untracked','waiting_approval') and (not j.get('card_id') or j.get('card_id') not in s['sessions'])]
+  known={j.get('card_id') for j in remote['jobs'] if j.get('card_id')}
+  for cid in known-set(s['sessions']):s['coverage']['untracked_job:'+cid]='unavailable'
+  remote_ledger=remote.get('reconciliation')
+  if not isinstance(remote_ledger,dict):s['coverage']['backend_ledger']='ok' if remote.get('reconciliation_error')=='not_published' else 'not_installed'
+  else:
+   s['previous_items']=remote_ledger.get('items',[])
+   s['coverage']['backend_ledger']='ok'
+   if s['coverage'].get('mockups')!='ok':s['retained_items']=[x for x in s['previous_items'] if x.get('kind')=='mockup']
+ except Exception:s['coverage']['remote_jobs']='unavailable'
+ urls=sorted({w['pr_url'] for w in s['workflows'].values() if w.get('pr_url')})
+ with ThreadPoolExecutor(max_workers=4) as pool:
+  for url,pr in pool.map(pr_observation,urls):
+   if pr:s['prs'][url]=pr
+   else:s['coverage']['pr:'+digest(url)]='unavailable'
+ # Existing deterministic mockup IDs are shared with mockup_route.py, including archived lineage.
+ for c in cards:
+  if c.get('id','').startswith('mockup-build-'):s['workflows'].setdefault(c['id'],{})
+ classify_priorities(s,read_json(root/'jobs/priority-overrides.json',{}))
+ return s
+
