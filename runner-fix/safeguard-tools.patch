+            candidate.mkdir()
+            protected.mkdir()
+            (candidate / 'data').write_bytes(b'12345')
+            (protected / 'private').write_bytes(b'123456789')
+            original = os.scandir
+            swapped = False
+            def swap_before_scandir(value):
+                nonlocal swapped
+                if not swapped:
+                    candidate.rename(root / 'original')
+                    candidate.symlink_to(protected, target_is_directory=True)
+                    swapped = True
+                return original(value)
+            with patch.object(module.os, 'scandir', swap_before_scandir):
+                size, _, complete = module.cleanup_size(candidate, 100)
+            self.assertEqual(size, 5)
+            self.assertTrue(complete)
+
+
+if __name__ == '__main__':
