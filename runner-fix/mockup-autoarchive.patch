--- /dev/null
+++ mockup_autoarchive.py
@@ -0,0 +1,335 @@
+#!/usr/bin/env python3
+"""Archive reviewed, completed, or stale superseded mockup batches on the mini.
+
+Dry-run is the default. Writes require --apply and the reviewed enable flag.
+"""
+import argparse
+from contextlib import contextmanager
+from datetime import datetime, timedelta, timezone
+import fcntl
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import sys
+import tempfile
+import time
+
+ENABLE_FLAG = 'TED_MOCKUP_AUTOARCHIVE_ENABLED'
+LOG_PATH = Path.home() / 'ted-ops/ted-board/mockup-autoarchive.jsonl'
+VERDICTS = {'approved', 'scrapped', 'picked'}
+META_TITLE = re.compile(r'(?:^|:\s*)(?:notes\s*(?=$|[:,])|who made and checked this\b)', re.I)
+REVISION = re.compile(r'(?<!\w)(?:v(?:ersion)?\s*\d+(?:\.\d+)*|round\s*\d+|'
+                      r'\d{8}|\d{4}-\d{2}-\d{2}|\d{1,2}[-/]\d{1,2})(?!\w)', re.I)
+MOCKUP_LINK = re.compile(r'\bmockup ID:\s*([A-Za-z0-9-]+)\b', re.I)
+
+
+def _time(value):
+    if not isinstance(value, str):
+        return None
+    try:
+        result = datetime.fromisoformat(value.replace('Z', '+00:00'))
+        return result.astimezone(timezone.utc) if result.tzinfo else None
+    except ValueError:
+        return None
+
+
+def _verdict(row):
+    return row.get('verdict') or ('picked' if row['status'] == 'picked' else None)
+
+
+def _prefix(name):
+    marker = REVISION.search(name)
+    return re.sub(r'[\W_]+', ' ', name[:marker.start()] if marker else name).strip().casefold()
+
+
+def _created(rows, earliest=False):
+    dates = [_time(row.get('created_at')) for row in rows]
+    return (min(dates) if earliest else max(dates)) if all(dates) else None
+
+
+def _activity(rows):
+    dates = []
+    for row in rows:
+        created = _time(row.get('created_at'))
+        if created is None:
+            return None
+        dates.append(created)
+        change = row.get('verdict_change') or {}
+        if not isinstance(change, dict):
+            return None
+        values = [row.get('verdict_at'), row.get('picked_at'), change.get('at')]
+        activity = [_time(value) for value in values if value is not None]
+        if any(date is None for date in activity) or (_verdict(row) and not activity):
+            return None
+        dates.extend(activity)
+    return max(dates)
+
+
+def _undo_pending(rows, now):
+    for row in rows:
+        change = row.get('verdict_change')
+        if change is not None and not isinstance(change, dict):
+            return True
+        value = (change or {}).get('undo_until')
+        if value is not None:
+            until = _time(value)
+            if until is None or until > now:
+                return True
+    return False
+
+
+def candidates(mockups, cards, now, *, pins=None):
+    """Return exact active batches and their evidence, without side effects."""
+    if not isinstance(mockups, list) or not isinstance(cards, list):
+        raise ValueError('Invalid archive snapshot')
+    pins = [] if pins is None else pins
+    if not isinstance(pins, list) or any(
+            not isinstance(pin, dict) or not isinstance(pin.get('mockup_id'), str)
+            or not pin['mockup_id'] or type(pin.get('resolved')) is not bool for pin in pins):
+        raise ValueError('Invalid pin snapshot')
+    unresolved = {pin['mockup_id'] for pin in pins if not pin['resolved']}
+    groups = {}
+    seen = set()
+    for row in mockups:
+        if (not isinstance(row, dict) or any(not isinstance(row.get(k), str) or not row[k]
+                for k in ('id', 'project', 'batch', 'title'))
+                or row.get('status') not in ('open', 'picked', 'archived') or row['id'] in seen):
+            raise ValueError('Invalid mockup snapshot')
+        seen.add(row['id'])
+        groups.setdefault((row['project'], row['batch']), []).append(row)
+    if any(not isinstance(card, dict) or any(not isinstance(card.get(k), str)
+           for k in ('id', 'project', 'section', 'title'))
+           or (card.get('body') is not None and not isinstance(card['body'], str)) for card in cards):
+        raise ValueError('Invalid card snapshot')
+    result = []
+    for (project, batch), rows in sorted(groups.items()):
+        active = [row for row in rows if row['status'] != 'archived']
+        if not active or _undo_pending(active, now):
+            continue
+        if any(row['id'] in unresolved for row in rows):
+            continue
+        activity = _activity(rows)
+        if activity is None or now - activity < timedelta(hours=24):
+            continue
+        reviewable = [row for row in active if not META_TITLE.search(row['title'])]
+        decision = dict(project=project, batch=batch, ids=sorted(row['id'] for row in active),
+                        total=len(rows), reviewable=len(reviewable), ignored=len(active)-len(reviewable))
+        explicit = {row.get('card_id') for row in rows if isinstance(row.get('card_id'), str)}
+        if not explicit.issubset({card['id'] for card in cards}):
+            continue
+        ids = {row['id'] for row in rows}
+        linked = [card for card in cards if (
+            card['id'] in explicit or card['title'] == 'build approved: ' + batch
+            or card.get('batch') == batch or (card['project'] == project and
+                ids.intersection(MOCKUP_LINK.findall(card.get('body') or ''))))]
+        if reviewable and all(_verdict(row) in VERDICTS for row in reviewable):
+            if any(card['section'] not in ('done', 'killed') for card in linked):
+                continue
+            result.append(dict(decision, reason='all_reviewed'))
+            continue
+        completion_links = [card for card in linked
+                            if card['id'] in explicit or card['project'] == project]
+        whole_batch_link = any(card['id'] in explicit or card['title'] == 'build approved: ' + batch
+                               for card in completion_links)
+        every_frame_reviewed = bool(reviewable) and all(
+            _verdict(row) in VERDICTS | {'needs_work'} for row in reviewable)
+        if (completion_links and all(card['section'] in ('done', 'killed') for card in linked)
+                and (whole_batch_link or every_frame_reviewed)):
+            reason = 'linked_card_killed' if any(card['section'] == 'killed' for card in completion_links) else 'linked_card_done'
+            result.append(dict(decision, reason=reason, card_ids=sorted(card['id'] for card in completion_links)))
+            continue
+        if any(card['section'] not in ('done', 'killed') for card in linked):
+            continue
+        created = _created(rows)
+        prefix = _prefix(batch)
+        if activity is None or created is None or not prefix or now - activity < timedelta(days=5):
+            continue
+        newer = [(other_batch, _created(other_rows, earliest=True))
+                 for (other_project, other_batch), other_rows in groups.items()
+                 if other_project == project and other_batch != batch and _prefix(other_batch) == prefix]
+        newer = [(name, date) for name, date in newer if date is not None and date > created]
+        if newer:
+            newest = max(newer, key=lambda pair: (pair[1], pair[0]))[0]
+            result.append(dict(decision, reason='stale_superseded', newer_batch=newest,
+                               last_activity=activity.isoformat(), prefix=prefix))
+    return result
+
+
+def _log(path, event):
+    with Path(path).open('a', encoding='utf-8') as stream:
+        stream.write(json.dumps(event, ensure_ascii=True, sort_keys=True) + '\n')
+        stream.flush()
+        os.fsync(stream.fileno())
+
+
+@contextmanager
+def _locked_state(path):
+    with path.with_suffix('.lock').open('a') as lock:
+        deadline = time.monotonic() + 1.0
+        while True:
+            try:
+                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+                break
+            except BlockingIOError:
+                remaining = deadline - time.monotonic()
+                if remaining <= 0:
+                    raise TimeoutError('Archive state lock is busy') from None
+                time.sleep(min(0.05, remaining))
+        try:
+            state = json.loads(path.read_text())
+        except FileNotFoundError:
+            state = dict(heartbeat_at=None, batches={})
+        if (not isinstance(state, dict) or not isinstance(state.get('batches'), dict)
+                or any(not isinstance(key, str) or not isinstance(value, str)
+                       for key, value in state['batches'].items())
+                or (state.get('heartbeat_at') is not None and _time(state['heartbeat_at']) is None)):
+            raise ValueError('Invalid archive state')
+        yield state
+
+
+def _save_state(path, state):
+    temporary = None
+    try:
+        with tempfile.NamedTemporaryFile('w', encoding='utf-8', dir=path.parent,
+                                         prefix=path.name + '.', delete=False) as stream:
+            temporary = Path(stream.name)
+            json.dump(state, stream, ensure_ascii=True, sort_keys=True)
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.replace(temporary, path)
+    finally:
+        if temporary is not None:
+            temporary.unlink(missing_ok=True)
+
+
+def _batch_key(candidate):
+    return json.dumps([candidate['project'], candidate['batch']], ensure_ascii=True)
+
+
+def _record_outcome(log_path, event, state, state_path, observed=None):
+    evidence = dict(outcome={key: value for key, value in event.items() if key != 'at'}, observed=observed)
+    signature = hashlib.sha256(json.dumps(evidence, sort_keys=True).encode()).hexdigest()
+    key = _batch_key(event)
+    if (event['event'] in ('archive_failed', 'skipped_changed')
+            and state['batches'].get(key) == signature):
+        return
+    _log(log_path, event)
+    state['batches'][key] = signature
+    _save_state(state_path, state)
+
+
+def run_pass(*, dry_run=True, mockup_call=None, cards_call=None, log_path=LOG_PATH, now=None,
+             heartbeat=False):
+    """Serialize passes and persist heartbeat cadence and per-batch outcome state."""
+    if not dry_run and os.environ.get(ENABLE_FLAG) != 'true':
+        raise RuntimeError('Mockup auto-archive is not enabled')
+    log_path = Path(log_path)
+    if dry_run:
+        return _run_pass(dry_run=True, mockup_call=mockup_call, cards_call=cards_call,
+                         log_path=log_path, now=now, state=None, state_path=None)
+    state_path = log_path.with_suffix('.state.json')
+    with _locked_state(state_path) as state:
+        if heartbeat:
+            at = now or datetime.now(timezone.utc)
+            previous = _time(state.get('heartbeat_at'))
+            if previous is not None and previous - at > timedelta(minutes=10):
+                previous = None
+            if previous is not None and at - previous < timedelta(minutes=10):
+                return []
+            # Claim the interval before network I/O, including attempts that fail.
+            state['heartbeat_at'] = at.isoformat()
+            _save_state(state_path, state)
+        return _run_pass(dry_run=dry_run, mockup_call=mockup_call, cards_call=cards_call,
+                         log_path=log_path, now=now, state=state, state_path=state_path)
+
+
+def _run_pass(*, dry_run, mockup_call, cards_call, log_path, now, state, state_path):
+    """Read candidates, log their reasons, and optionally archive after rechecking."""
+    if not dry_run and os.environ.get(ENABLE_FLAG) != 'true':
+        raise RuntimeError('Mockup auto-archive is not enabled')
+    if mockup_call is None:
+        from mockup_client import call as mockup_call
+    if cards_call is None:
+        from board_client import call as cards_call
+    from board_card_snapshot import fetch_cards
+    fixed_now = now
+    now = now or datetime.now(timezone.utc)
+
+    def read(at):
+        snapshot = mockup_call()
+        if (not isinstance(snapshot, dict) or not isinstance(snapshot.get('mockups'), list)
+                or not isinstance(snapshot.get('pins'), list)):
+            raise ValueError('Invalid mockup response')
+        return candidates(snapshot['mockups'], fetch_cards(call=cards_call), at, pins=snapshot['pins'])
+
+    planned = read(now)
+    if not dry_run:
+        keys = {_batch_key(candidate) for candidate in planned}
+        retained = {key: value for key, value in state['batches'].items() if key in keys}
+        if retained != state['batches']:
+            state['batches'] = retained
+            _save_state(state_path, state)
+    events = []
+    for candidate in planned:
+        event = dict(candidate, at=now.isoformat())
+        if dry_run:
+            event['event'] = 'would_archive'
+            _log(log_path, event)
+        else:
+            current = read(fixed_now or datetime.now(timezone.utc))
+            fresh = next((row for row in current if (row['project'], row['batch']) ==
+                          (candidate['project'], candidate['batch'])), None)
+            if fresh != candidate:
+                event['event'] = 'skipped_changed'
+                _record_outcome(log_path, event, state, state_path, observed=fresh)
+                events.append(event)
+                continue
+            # A durable intent is required before the network write.
+            _log(log_path, dict(event, event='archive_attempt'))
+            confirmed = 0
+            try:
+                # The existing API accepts at most 500 explicit IDs per request.
+                for start in range(0, len(candidate['ids']), 500):
+                    ids = candidate['ids'][start:start+500]
+                    receipt = mockup_call('archive', ids=ids)
+                    if (not isinstance(receipt, dict) or receipt.get('ok') is not True
+                            or type(receipt.get('archived')) is not int
+                            or receipt['archived'] != len(ids)):
+                        raise RuntimeError('Archive was not confirmed')
+                    confirmed += receipt['archived']
+                event.update(event='archived', archived=confirmed)
+            except Exception as exc:
+                event.update(event='archive_failed', archived=confirmed, error_type=type(exc).__name__)
+            _record_outcome(log_path, event, state, state_path)
+        events.append(event)
+    return events
+
+
+def heartbeat_pass(*, now=None, log_path=LOG_PATH):
+    if os.environ.get(ENABLE_FLAG) != 'true':
+        return []
+    return run_pass(dry_run=False, now=now, log_path=log_path, heartbeat=True)
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    mode = parser.add_mutually_exclusive_group()
+    mode.add_argument('--dry-run', action='store_true', help='List and log candidates without writes (default)')
+    mode.add_argument('--apply', action='store_true', help='Archive after Ted review and explicit enablement')
+    parser.add_argument('--log', type=Path, default=LOG_PATH)
+    args = parser.parse_args(argv)
+    try:
+        events = run_pass(dry_run=not args.apply, log_path=args.log)
+        for event in events:
+            print(json.dumps(event, ensure_ascii=True, sort_keys=True))
+        print('Mockup auto-archive: ' + str(len(events)) + ' batch result(s).')
+        return 1 if any(event['event'] == 'archive_failed' for event in events) else 0
+    except (OSError, ValueError, RuntimeError, ModuleNotFoundError):
+        print('Mockup auto-archive failed. Check local access and the audit log.', file=sys.stderr)
+        return 1
+
+
+if __name__ == '__main__':
+    sys.exit(main())
