--- /dev/null
+++ mockup_autoarchive.py
@@ -0,0 +1,209 @@
+#!/usr/bin/env python3
+"""Archive reviewed, completed, or stale superseded mockup batches on the mini.
+
+Dry-run is the default. Writes require --apply and the reviewed enable flag.
+"""
+import argparse
+from datetime import datetime, timedelta, timezone
+import json
+import os
+from pathlib import Path
+import re
+import sys
+
+ENABLE_FLAG = 'TED_MOCKUP_AUTOARCHIVE_ENABLED'
+LOG_PATH = Path.home() / 'ted-ops/ted-board/mockup-autoarchive.jsonl'
+VERDICTS = {'approved', 'needs_work', 'scrapped', 'picked'}
+META_TITLE = re.compile(r'(?:^|:\s*)(?:notes\s*(?=$|[:,])|who made and checked this\b)', re.I)
+REVISION = re.compile(r'(?<!\w)(?:v(?:ersion)?\s*\d+(?:\.\d+)*|round\s*\d+|'
+                      r'\d{8}|\d{4}-\d{2}-\d{2}|\d{1,2}[-/]\d{1,2})(?!\w)', re.I)
+MOCKUP_LINK = re.compile(r'\bmockup ID:\s*([A-Za-z0-9-]+)\b', re.I)
+
+
+def _time(value):
+    if not isinstance(value, str):
+        return None
+    try:
+        result = datetime.fromisoformat(value.replace('Z', '+00:00'))
+        return result.astimezone(timezone.utc) if result.tzinfo else None
+    except ValueError:
+        return None
+
+
+def _verdict(row):
+    return row.get('verdict') or ('picked' if row['status'] == 'picked' else None)
+
+
+def _prefix(name):
+    marker = REVISION.search(name)
+    return re.sub(r'[\W_]+', ' ', name[:marker.start()] if marker else name).strip().casefold()
+
+
+def _created(rows, earliest=False):
+    dates = [_time(row.get('created_at')) for row in rows]
+    return (min(dates) if earliest else max(dates)) if all(dates) else None
+
+
+def _activity(rows):
+    dates = []
+    for row in rows:
+        created = _time(row.get('created_at'))
+        if created is None:
+            return None
+        dates.append(created)
+        change = row.get('verdict_change') or {}
+        values = [row.get('verdict_at'), row.get('picked_at'), change.get('at')]
+        activity = [_time(value) for value in values if value is not None]
+        if any(date is None for date in activity) or (_verdict(row) and not activity):
+            return None
+        dates.extend(activity)
+    return max(dates)
+
+
+def _undo_pending(rows, now):
+    for row in rows:
+        change = row.get('verdict_change')
+        if change is not None and not isinstance(change, dict):
+            return True
+        value = (change or {}).get('undo_until')
+        if value is not None:
+            until = _time(value)
+            if until is None or until > now:
+                return True
+    return False
+
+
+def candidates(mockups, cards, now):
+    """Return exact active batches and their evidence, without side effects."""
+    if not isinstance(mockups, list) or not isinstance(cards, list):
+        raise ValueError('Invalid archive snapshot')
+    groups = {}
+    seen = set()
+    for row in mockups:
+        if (not isinstance(row, dict) or any(not isinstance(row.get(k), str) or not row[k]
+                for k in ('id', 'project', 'batch', 'title'))
+                or row.get('status') not in ('open', 'picked', 'archived') or row['id'] in seen):
+            raise ValueError('Invalid mockup snapshot')
+        seen.add(row['id'])
+        groups.setdefault((row['project'], row['batch']), []).append(row)
+    if any(not isinstance(card, dict) or any(not isinstance(card.get(k), str)
+           for k in ('id', 'project', 'section', 'title')) for card in cards):
+        raise ValueError('Invalid card snapshot')
+    result = []
+    for (project, batch), rows in sorted(groups.items()):
+        active = [row for row in rows if row['status'] != 'archived']
+        if not active or _undo_pending(active, now):
+            continue
+        reviewable = [row for row in active if not META_TITLE.search(row['title'])]
+        decision = dict(project=project, batch=batch, ids=sorted(row['id'] for row in active),
+                        total=len(rows), reviewable=len(reviewable), ignored=len(active)-len(reviewable))
+        if reviewable and all(_verdict(row) in VERDICTS for row in reviewable):
+            result.append(dict(decision, reason='all_reviewed'))
+            continue
+        explicit = {row.get('card_id') for row in rows if isinstance(row.get('card_id'), str)}
+        ids = {row['id'] for row in rows}
+        linked = [card for card in cards if card['project'] == project and (
+            card['id'] in explicit or card['title'] == 'build approved: ' + batch or
+            ids.intersection(MOCKUP_LINK.findall(card.get('body') or '')))]
+        if linked and all(card['section'] in ('done', 'killed') for card in linked):
+            reason = 'linked_card_killed' if any(card['section'] == 'killed' for card in linked) else 'linked_card_done'
+            result.append(dict(decision, reason=reason, card_ids=sorted(card['id'] for card in linked)))
+            continue
+        activity = _activity(rows)
+        created = _created(rows)
+        prefix = _prefix(batch)
+        if activity is None or created is None or not prefix or now - activity < timedelta(days=5):
+            continue
+        newer = [(other_batch, _created(other_rows, earliest=True))
+                 for (other_project, other_batch), other_rows in groups.items()
+                 if other_project == project and other_batch != batch and _prefix(other_batch) == prefix]
+        newer = [(name, date) for name, date in newer if date is not None and date > created]
+        if newer:
+            newest = max(newer, key=lambda pair: (pair[1], pair[0]))[0]
+            result.append(dict(decision, reason='stale_superseded', newer_batch=newest,
+                               last_activity=activity.isoformat(), prefix=prefix))
+    return result
+
+
+def _log(path, event):
+    with Path(path).open('a', encoding='utf-8') as stream:
+        stream.write(json.dumps(event, ensure_ascii=True, sort_keys=True) + '\n')
+        stream.flush()
+        os.fsync(stream.fileno())
+
+
+def run_pass(*, dry_run=True, mockup_call=None, cards_call=None, log_path=LOG_PATH, now=None):
+    """Read candidates, log their reasons, and optionally archive after rechecking."""
+    if not dry_run and os.environ.get(ENABLE_FLAG) != 'true':
+        raise RuntimeError('Mockup auto-archive is not enabled')
+    if mockup_call is None:
+        from mockup_client import call as mockup_call
+    if cards_call is None:
+        from board_client import cards as cards_call
+    fixed_now = now
+    now = now or datetime.now(timezone.utc)
+
+    def read(at):
+        snapshot = mockup_call()
+        if not isinstance(snapshot, dict) or not isinstance(snapshot.get('mockups'), list):
+            raise ValueError('Invalid mockup response')
+        return candidates(snapshot['mockups'], cards_call(), at)
+
+    planned = read(now)
+    events = []
+    for candidate in planned:
+        event = dict(candidate, at=now.isoformat())
+        if dry_run:
+            event['event'] = 'would_archive'
+            _log(log_path, event)
+        else:
+            current = read(fixed_now or datetime.now(timezone.utc))
+            fresh = next((row for row in current if (row['project'], row['batch']) ==
+                          (candidate['project'], candidate['batch'])), None)
+            if fresh != candidate:
+                event['event'] = 'skipped_changed'
+                _log(log_path, event)
+                events.append(event)
+                continue
+            # A durable intent is required before the network write.
+            _log(log_path, dict(event, event='archive_attempt'))
+            try:
+                receipt = mockup_call('archive', project=candidate['project'], batch=candidate['batch'])
+                if (not isinstance(receipt, dict) or receipt.get('ok') is not True
+                        or type(receipt.get('archived')) is not int
+                        or receipt['archived'] != candidate['total']):
+                    raise RuntimeError('Archive was not confirmed')
+                event.update(event='archived', archived=receipt['archived'])
+            except Exception as exc:
+                event.update(event='archive_failed', error_type=type(exc).__name__)
+            _log(log_path, event)
+        events.append(event)
+    return events
+
+
+def heartbeat_pass():
+    if os.environ.get(ENABLE_FLAG) != 'true':
+        return []
+    return run_pass(dry_run=False)
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    mode = parser.add_mutually_exclusive_group()
+    mode.add_argument('--dry-run', action='store_true', help='List and log candidates without writes (default)')
+    mode.add_argument('--apply', action='store_true', help='Archive after Ted review and explicit enablement')
+    parser.add_argument('--log', type=Path, default=LOG_PATH)
+    args = parser.parse_args(argv)
+    try:
+        events = run_pass(dry_run=not args.apply, log_path=args.log)
+        for event in events:
+            print(json.dumps(event, ensure_ascii=True, sort_keys=True))
+        print('Mockup auto-archive: ' + str(len(events)) + ' batch result(s).')
+        return 1 if any(event['event'] == 'archive_failed' for event in events) else 0
+    except (OSError, ValueError, RuntimeError):
+        print('Mockup auto-archive failed. Check local access and the audit log.', file=sys.stderr)
+        return 1
+
+
+if __name__ == '__main__':
+    sys.exit(main())
