--- /dev/null
+++ reconciler_gate.py
@@ -0,0 +1,26 @@
+"""Safe opt-in boundary. Invalid configuration never crashes a legacy caller."""
+import json
+import os
+from pathlib import Path
+import sys
+
+CONFIG_PATH = Path(__file__).resolve().parent / 'jobs/reconciler-config.json'
+
+
+def reconciler_enabled(config_path=None, *, strict=False):
+    path = Path(config_path) if config_path is not None else CONFIG_PATH
+    try:
+        try:
+            if path.is_symlink():
+                raise ValueError()
+            value = json.loads(path.read_text())
+        except FileNotFoundError:
+            value = {'enabled': False}
+        if not isinstance(value, dict) or type(value.get('enabled')) is not bool:
+            raise ValueError()
+        return value['enabled'] or os.environ.get('TED_RECONCILER_ENABLED', '').lower() == 'true'
+    except (OSError, ValueError):
+        print('reconciler configuration invalid; legacy mode remains active; apply is blocked', file=sys.stderr)
+        if strict:
+            raise RuntimeError('invalid reconciler configuration blocks apply') from None
+        return False
