+#!/usr/bin/env python3
+"""Bounded, read-only retention candidates. There is no apply or deletion mode."""
+import argparse
+import json
+import os
+from pathlib import Path
+import re
+import stat
+import subprocess
+import sys
+import time
+
+DAY = 86400
+ID = re.compile(r'^[A-Za-z0-9._-]{1,100}$')
+TERMINAL = {'done', 'killed'}
+JOB_SUFFIXES = {'.events', '.log', '.jsonl', '.claim'}
+
+
+def safe_path(value):
+    if not isinstance(value, (str, os.PathLike)) or not str(value).strip():
+        raise ValueError('explicit absolute path required')
+    path = Path(value)
+    if not path.is_absolute() or path in (Path('/'), Path.home()):
+        raise ValueError('narrow absolute path required')
+    if any(part.casefold() == 'documents' for part in path.parts):
+        raise ValueError('protected path')
+    for part in [*reversed(path.parents), path]:
+        alias = part in (Path('/var'), Path('/tmp')) and part.resolve() == Path('/private') / part.name
+        if part.is_symlink() and not alias:
+            raise ValueError('symlink path')
+    resolved = path.resolve()
+    if resolved in (Path('/'), Path.home()) or any(part.casefold() == 'documents' for part in resolved.parts):
+        raise ValueError('protected root')
+    return resolved
+
+
+def open_path(path):
+    fd = os.open('/', os.O_RDONLY | os.O_DIRECTORY)
+    try:
+        for index, component in enumerate(path.parts[1:]):
+            flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
+            if index < len(path.parts) - 2:
+                flags |= os.O_DIRECTORY
+            next_fd = os.open(component, flags, dir_fd=fd)
+            os.close(fd)
+            fd = next_fd
+        return fd
+    except BaseException:
+        os.close(fd)
+        raise
+
+
+def read_regular(path, limit):
+    with os.fdopen(open_path(path), 'rb') as stream:
+        info = os.fstat(stream.fileno())
+        if not stat.S_ISREG(info.st_mode) or info.st_size > limit:
+            raise ValueError('bounded regular file required')
+        raw = stream.read(limit + 1)
+    if len(raw) > limit:
+        raise ValueError('read budget exceeded')
+    return raw
+
+
+def report_done(path):
+    try:
+        descriptor = open_path(path)
+    except FileNotFoundError:
+        return False
+    with os.fdopen(descriptor, 'rb') as stream:
+        if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
+            return False
+        return stream.read(4096).splitlines()[:1] in ([b'LIVE_STATE: done'], [b'LIVE_STATE: killed'])
+
+
+def ownership(state):
+    if not isinstance(state, dict):
+        raise ValueError('unknown session store')
+    sessions, approvals = state.get('sessions'), state.get('approvals', {})
+    if not isinstance(sessions, dict) or not isinstance(approvals, dict):
+        raise ValueError('unknown ownership')
+    if any(not isinstance(s, dict) or not isinstance(s.get('queue'), list) for s in sessions.values()):
+        raise ValueError('unknown session shape')
+    if any(not isinstance(a, dict) or not a.get('card_id') or not a.get('status') for a in approvals.values()):
+        raise ValueError('unknown approval ownership')
+    return dict(sessions={cid:{k:s.get(k) for k in ('status','cwd','queue','pid','identity')}
+                          for cid,s in sessions.items()},
+                approvals={aid:{k:a.get(k) for k in ('card_id','status')} for aid,a in approvals.items()})
+
+
+def within(path, parent):
+    return path == parent or parent in path.parents
+
+
+class Budget:
+    def __init__(self, entries, seconds):
+        if type(entries) is not int or not 1 <= entries <= 100_000 or not 0 < seconds <= 60:
+            raise ValueError('bounded scan required')
+        self.remaining = entries
+        self.deadline = time.monotonic() + seconds
+
+    def take(self):
+        self.remaining -= 1
+        if self.remaining < 0 or time.monotonic() > self.deadline:
+            raise ValueError('scan budget exceeded')
+
+
+def scan_tree(path, budget, skip=(), *, registered_worktree=False):
+    pending = [path]
+    size = 0
+    newest = 0
+    safe = True
+    files = []
+    directories = []
+    while pending:
+        current = pending.pop()
+        budget.take()
+        if current in skip:
+            safe = False
+            continue
+        if current.name.casefold() == 'documents':
+            safe = False
+            continue
+        fd = open_path(current)
+        try:
+            info = os.fstat(fd)
+            newest = max(newest, info.st_mtime)
+            if stat.S_ISREG(info.st_mode):
+                size += info.st_size
+                files.append((current, info.st_size, info.st_mtime))
+            elif stat.S_ISDIR(info.st_mode):
+                if current != path:
+                    directories.append(current)
+                with os.scandir(fd) as children:
+                    for child in children:
+                        # Bound the pending list too; do not open a descriptor per child.
+                        if len(pending) >= budget.remaining:
+                            raise ValueError('scan budget exceeded')
+                        if child.name.casefold() == '.git':
+                            budget.take()
+                            # Only a verified registration's own pointer is metadata.
+                            if not (registered_worktree and current == path and child.name == '.git'):
+                                safe = False
+                            continue
+                        if child.is_symlink() or child.name.casefold() == 'documents':
+                            budget.take()
+                            safe = False
+                            continue
+                        pending.append(current / child.name)
+            else:
+                safe = False
+        finally:
+            os.close(fd)
+    return dict(bytes=size, newest=newest, safe=safe, files=files, directories=directories)
+
+
+def load_cards():
+    """Read current cards through the existing private board client, without writes."""
+    runtime = str(Path(__file__).resolve().parents[1])
+    if runtime not in sys.path:
+        sys.path.insert(0, runtime)
+    from board_client import cards
+    return cards()
+
+
+def card_snapshot(rows):
+    if not isinstance(rows, list):
+        raise ValueError('unknown card evidence')
+    result = {}
+    for row in rows:
+        if not isinstance(row, dict) or not isinstance(row.get('id'), str) or not ID.fullmatch(row['id']) or row['id'] in result:
+            raise ValueError('unknown or duplicate card identity')
+        result[row['id']] = {k:row[k] for k in ('section','status') if k in row}
+    return result
+
+
+def terminal_card(row):
+    if not isinstance(row, dict):
+        return False
+    values = [row[k] for k in ('section','status') if k in row and row[k] is not None]
+    return bool(values) and all(isinstance(v, str) and v in TERMINAL for v in values)
+
+
+def allowed_job_file(path):
+    return bool(ID.fullmatch(path.name)) and (path.name.casefold() in ('report.md','brief.md') or
+                                             path.suffix.casefold() in JOB_SUFFIXES)
+
+
+def process_cwds():
+    result = subprocess.run(['/usr/sbin/lsof', '-a', '-u', str(os.getuid()), '-d', 'cwd', '-Fn'],
+                            capture_output=True, text=True, timeout=10, check=True)
+    if len(result.stdout) > 4_194_304:
+        raise ValueError('process evidence too large')
+    return [Path(line[1:]) for line in result.stdout.splitlines() if line.startswith('n/')]
+
+
+def git(repo, *args, check=True):
+    result = subprocess.run(['git', '--no-optional-locks', '-c', 'core.fsmonitor=false', '-C', str(repo), *args],
+                            capture_output=True, timeout=10, check=check)
+    if len(result.stdout) > 4_194_304:
+        raise ValueError('git evidence too large')
+    return result
+
+
+def worktrees(repos):
+    rows = []
+    seen_common, seen_paths = set(), set()
+    for repo in dict.fromkeys(safe_path(p) for p in repos):
+        common = Path(git(repo, 'rev-parse', '--git-common-dir').stdout.decode().strip())
+        common = safe_path(common if common.is_absolute() else repo/common)
+        if common in seen_common:
+            continue
+        seen_common.add(common)
+        output = git(repo, 'worktree', 'list', '--porcelain', '-z').stdout.decode()
+        current = None
+        first = True
+        main_checkout = None
+        for field in output.split('\x00'):
+            if field.startswith('worktree '):
+                path = safe_path(field[9:])
+                if path in seen_paths:
+                    raise ValueError('conflicting worktree registrations')
+                seen_paths.add(path)
+                if first:
+                    main_checkout = common.parent if common.name=='.git' else path
+                current = dict(path=path, repo=repo, common=common,
+                               main=first or path==main_checkout,
+                               main_checkout=main_checkout)
+                first = False
+                rows.append(current)
+                if len(rows) > 1000:
+                    raise ValueError('worktree budget exceeded')
+            elif current is not None and (field.startswith('locked') or field.startswith('prunable')):
+                current['protected'] = True
+    return rows
+
+
+def verified_merge_refs(repos, merged_ref):
+    if not isinstance(merged_ref, str) or not merged_ref.startswith('refs/remotes/') or \
+            not re.fullmatch(r'refs/remotes/[A-Za-z0-9._/-]+', merged_ref):
+        raise ValueError('remote tracking reference required')
+    result = {}
+    for repo in repos:
+        git(repo, 'check-ref-format', merged_ref)
+        result[repo] = git(repo, 'rev-parse', '--verify', '--end-of-options', merged_ref+'^{commit}').stdout.decode().strip()
+    return result
+
+
+def inventory(jobs_root, sessions_path, *, now=None, cwds=None, repos=(), worktree_roots=(),
+              merged_ref='refs/remotes/origin/main', max_entries=100_000, max_seconds=20,
+              job_days=90, event_days=30, worktree_days=30):
+    now = time.time() if now is None else now
+    if any(type(x) is not int or x < 1 for x in (job_days, event_days, worktree_days)):
+        raise ValueError('positive retention ages required')
+    jobs_root, sessions_path = safe_path(jobs_root), safe_path(sessions_path)
+    roots = list(dict.fromkeys(safe_path(p) for p in worktree_roots))
+    repos = list(dict.fromkeys(safe_path(p) for p in repos))
+    if roots and not repos:
+        raise ValueError('worktree scope requires repository evidence')
+    refs = verified_merge_refs(repos, merged_ref)
+    trees = worktrees(repos)
+    mains = {t['path'] for t in trees if t['main']} | {t['main_checkout'] for t in trees}
+    if any(within(main, root) for main in mains for root in roots):
+        raise ValueError('worktree scope contains main checkout')
+    raw = read_regular(sessions_path, 8_388_608)
+    state = json.loads(raw)
+    snapshot = ownership(state)
+    sessions, approvals = state['sessions'], state.get('approvals', {})
+    cards = card_snapshot(load_cards())
+    cwds = process_cwds() if cwds is None else [safe_path(p) for p in cwds]
+    if not isinstance(cwds, list):
+        raise ValueError('unknown process evidence')
+    budget = Budget(max_entries, max_seconds)
+    candidates, kept = [], []
+    complete = True
+    active = [Path(s['cwd']) for s in sessions.values() if s.get('cwd') and
+              (s.get('status') not in ('done', 'failed', 'killed') or s.get('queue') or s.get('pid'))]
+    def keep(path, reason):
+        kept.append(dict(path=str(path.relative_to(jobs_root)) if within(path, jobs_root) else path.name,
+                         reason=reason))
+    def names_in(path):
+        descriptor = open_path(path)
+        try:
+            with os.scandir(descriptor) as entries:
+                names = []
+                for entry in entries:
+                    budget.take()
+                    names.append((entry.name, entry.is_symlink()))
+                return names
+        finally:
+            os.close(descriptor)
+    gate_cache = {}
+    def job_state(name):
+        if name in gate_cache:
+            return gate_cache[name]
+        directory = jobs_root/name
+        session = sessions.get(name[5:]) if name.startswith('card-') and ID.fullmatch(name) else None
+        reason = None
+        if not isinstance(session, dict) or session.get('cwd') != str(directory):
+            reason = 'unknown owner'
+        elif session.get('status') not in ('done', 'failed', 'killed') or session.get('queue') or \
+                'pid' not in session or session['pid'] is not None:
+            reason = 'active or queued'
+        elif not terminal_card(cards.get(name[5:])):
+            reason = 'card missing or nonterminal'
+        elif any(a.get('card_id')==name[5:] and a.get('status') not in ('done','superseded') for a in approvals.values()):
+            reason = 'approval unresolved'
+        elif any(within(p, directory) for p in cwds):
+            reason = 'live process cwd'
+        else:
+            entries = names_in(directory)
+            if any(n.casefold().endswith('.claim') for n,link in entries):
+                reason = 'claim present'
+            else:
+                reports = [directory/n for n,link in entries if n.casefold()=='report.md' and not link]
+                if len(reports)!=1 or not report_done(reports[0]):
+                    reason = 'report pending or unknown'
+        gate_cache[name] = reason
+        return reason
+    names = [name for name,link in names_in(jobs_root)
+             if name.startswith('card-') and ID.fullmatch(name) and not link]
+    for name in sorted(names):
+        directory = jobs_root/name
+        try:
+            reason = job_state(name)
+            if reason:
+                keep(directory, reason)
+                continue
+            scan = scan_tree(directory, budget, skip=[t['path'] for t in trees])
+            if scan['directories'] or any(not allowed_job_file(p) for p,size,modified in scan['files']):
+                keep(directory, 'unrecognized artifact')
+                continue
+            if not scan['safe']:
+                keep(directory, 'excluded subtree or registration')
+                continue
+            if any(p.name.casefold().endswith('.claim') for p,size,modified in scan['files']):
+                keep(directory, 'claim present')
+                continue
+            if now-scan['newest'] >= job_days*DAY:
+                candidates.append(dict(kind='job_directory',root='jobs',path=name,bytes=scan['bytes'],requires_archive=True))
+            else:
+                for path,size,modified in scan['files']:
+                    if path.parent==directory and path.suffix.casefold() in ('.events','.log','.jsonl') and \
+                            now-modified>=event_days*DAY:
+                        candidates.append(dict(kind='event_file',root='jobs',path=str(path.relative_to(jobs_root)),
+                                               bytes=size,requires_archive=False))
+                keep(directory,'directory retained by age')
+        except (OSError, ValueError, IndexError):
+            keep(directory,'incomplete or unreadable scan')
+            complete = False
+    for tree in trees:
+        path = tree['path']
+        matching = next((i for i,root in enumerate(roots) if within(path,root)),None)
+        if tree['main'] or tree.get('protected') or matching is None:
+            continue
+        if any(within(cwd,path) for cwd in cwds) or any(within(p,path) or within(path,p) for p in active):
+            keep(path,'active worktree')
+            continue
+        try:
+            if within(path,jobs_root):
+                parts = path.relative_to(jobs_root).parts
+                if not parts:
+                    keep(path,'jobs root is not a job')
+                    continue
+                reason = job_state(parts[0])
+                if reason:
+                    keep(path,reason)
+                    continue
+            common = Path(git(path,'rev-parse','--git-common-dir').stdout.decode().strip())
+            common = safe_path(common if common.is_absolute() else path/common)
+            top = safe_path(git(path,'rev-parse','--show-toplevel').stdout.decode().strip())
+            if common!=tree['common'] or top!=path:
+                keep(path,'worktree registration mismatch')
+                continue
+            if git(path,'status','--porcelain=v1','-z','--untracked-files=all','--ignored=matching').stdout:
+                keep(path,'dirty untracked or ignored files')
+                continue
+            if git(path,'merge-base','--is-ancestor','HEAD',refs[tree['repo']],check=False).returncode:
+                keep(path,'unmerged base')
+                continue
+            scan = scan_tree(path,budget,registered_worktree=True)
+            if any(p.name.casefold().endswith('.claim') for p,size,modified in scan['files']):
+                keep(path,'claim present')
+                continue
+            if not scan['safe'] or now-scan['newest']<worktree_days*DAY:
+                keep(path,'recent or excluded subtree')
+                continue
+            candidates.append(dict(kind='worktree',root='worktree_'+str(matching),
+                                   path=str(path.relative_to(roots[matching])),bytes=scan['bytes'],requires_archive=False))
+        except (OSError,ValueError,IndexError,subprocess.SubprocessError):
+            keep(path,'incomplete worktree evidence')
+            complete = False
+    if ownership(json.loads(read_regular(sessions_path,8_388_608)))!=snapshot:
+        complete = False
+        kept.append(dict(path='sessions',reason='ownership changed during scan; rerun'))
+    if card_snapshot(load_cards())!=cards:
+        complete = False
+        kept.append(dict(path='cards',reason='card state changed during scan; rerun'))
+    if verified_merge_refs(repos,merged_ref)!=refs:
+        complete = False
+        kept.append(dict(path='refs',reason='merge reference changed during scan; rerun'))
+    if not complete:
+        candidates = []
+    return dict(dry_run=True,complete=complete,candidates=candidates,kept=kept,
+                roots=dict(jobs=str(jobs_root),**{'worktree_'+str(i):str(p) for i,p in enumerate(roots)}),
+                policy_days=dict(jobs=job_days,events=event_days,worktrees=worktree_days),
+                candidate_logical_bytes=sum(c['bytes'] for c in candidates),
+                entries_examined=max_entries-budget.remaining)
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--jobs-root', required=True)
+    parser.add_argument('--sessions')
+    parser.add_argument('--repo', action='append', default=[])
+    parser.add_argument('--worktree-root', action='append', default=[])
+    parser.add_argument('--merged-ref', default='refs/remotes/origin/main')
+    parser.add_argument('--max-entries', type=int, default=100_000)
+    parser.add_argument('--max-seconds', type=float, default=20)
+    args = parser.parse_args(argv)
+    try:
+        report = inventory(args.jobs_root, args.sessions if args.sessions is not None else Path(args.jobs_root)/'sessions.json', repos=args.repo,
+                           worktree_roots=args.worktree_root, merged_ref=args.merged_ref,
+                           max_entries=args.max_entries, max_seconds=args.max_seconds)
+    except (OSError, ValueError, TypeError, KeyError, IndexError, ImportError, RuntimeError, subprocess.SubprocessError):
+        print('Retention evidence unavailable; no changes made.', file=sys.stderr)
+        return 2
+    print(json.dumps(report, sort_keys=True))
+    return 0 if report['complete'] else 1
+
+
+if __name__ == '__main__':
+    sys.exit(main())
