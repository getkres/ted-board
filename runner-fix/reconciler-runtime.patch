+def group_members(pgid):
+ try:
+  result=subprocess.run(['/bin/ps','-axo','pid=,pgid=,uid=,stat='],capture_output=True,text=True,timeout=5)
+  if result.returncode:return None
+  members=[]
+  for row in result.stdout.splitlines():
+   fields=row.split()
+   if len(fields)!=4:return None
+   pid,group,uid,state=fields
+   if int(group)==int(pgid) and not state.startswith('Z'):
+    if int(uid)!=os.getuid():return None
+    members.append(int(pid))
+  return members
+ except (OSError,ValueError,subprocess.TimeoutExpired):return None
+
+
+def confirmed_stop(session):
+ from sessions import alive,safe_kill
+ lease=session.get('lease') or {}
+ pid=session.get('pid') or lease.get('pid');ident=session.get('identity') or lease.get('identity')
+ if not pid:return True
+ members=group_members(pid)
+ if members is None:return False
+ if not alive(pid,ident):return not members
+ if not safe_kill(pid,ident):return False
+ for _ in range(10):
+  members=group_members(pid)
+  if members is None:return False
+  if not members and not alive(pid,ident):return True
+  time.sleep(.1)
+ return False
+
+
+def execute(action,store,snapshot,board):
+ kind=action['kind'];p=action['payload'];cid=p.get('card_id')
+ if kind in ('retry','dead_letter'):
+  with store.locked() as data:
+   s=data['sessions'].get(cid)
+   if not s:return False
+   # Crash after local commit but before the SQLite receipt is a safe replay.
+   if s.get('recovery_action')==action['id']:return True
+   ok=recover_session(s,action,confirmed_stop)
+   if ok and kind=='dead_letter':store._out(data,s,'retries exhausted or unsafe to repeat, ted owns this recovery','reconciler-dlq-'+action['id'])
+   return ok
+ if kind=='dispatch':
+  c=next((c for c in snapshot['cards'] if c['id']==cid),None)
+  if not c:return False
+  store.enqueue(c,'Resume the card from REPORT.md and its files. Deliver and verify the requested outcome, and retain an accurate blocked state until it is live.','reconciler-dispatch-'+action['id'],engine='codex');return True
+ if kind=='create_build':
+  # card.create defaults to queued board work and no immediate model launch.
+  import card
+  card.create(p['project'],('build approved: '+p['batch'])[:200],('Build approved mockups. Preserve the approved, build, PR, merged, deployed, and verified chain. Batch: '+p['batch']+'\nMockup IDs: '+', '.join(p['mockup_ids']))[:2000],card_id=cid)
+  return True
+ if kind=='route_ted':
+  result=board.call('reconcile_route_ted',card_id=cid,expected_updated_at=p.get('expected_updated_at'),expected_section='needs_you',line='operational work belongs to ted, review queued')
+  return result.get('ok') is True
+ if kind in ('escalate_2h','escalate_12h','review_sla'):return True  # one ranked queue and banner avoid a note flood
+ if kind=='repair_metadata':return True  # atomic reconcile_publish already persisted this metadata
+ if kind=='close_verified':
+  card=next((c for c in snapshot['cards'] if c['id']==cid),{})
+  return board.call('reconcile_close_verified',card_id=cid,expected_updated_at=card.get('updated_at')).get('ok') is True
+ if kind in ('advance_deploy','advance_verify'):
+  # Ranked Ted queue is the safe stage executor for repo-specific merge, deploy,
+  # and verify policy. The next obligation is opened even while a card is done.
+  line={'advance_deploy':'merged pr needs deployment and a deployment receipt','advance_verify':'deployed change needs independent verification and a matching revision receipt','close_verified':'delivery verified, ted can close the chain'}[kind]
+ elif kind=='sebastian_escalation':line='your reserved decision has been waiting over 24 hours, ted has kept it in the decision queue'
+ elif kind=='ambiguous_link':return True  # visible coverage issue, no guessed build association
+ elif kind=='coverage_defect':return True  # published banner and local review queue carry this symptom
+ else:line='ted review required: '+kind.replace('_',' ')+', next action is overdue'
+ if not cid:return True
+ result=board.call('ted_reply',card_id=cid,text=line,token='reconciler-'+action['id'])
+ return result.get('ok') is True
+
+
+def run(snapshot,journal_path,now,dry_run=True,store=None,board=None):
+ completed=completed_readonly(journal_path)
+ result=plan(snapshot,completed=completed,now=now);result['applied']=False
+ if dry_run:return result
+ if store is None or board is None:raise ValueError('apply requires explicit effect adapters')
+ # Missing feeds must never overwrite an authoritative ledger or start guessed work.
+ if any(source in result['coverage_defects'] for source in ('backend_ledger','inbox_policy')):raise RuntimeError('Reviewed backend and inbox policy must be installed before apply')
+ publish={k:result[k] for k in ('generated_at','items','ted_queue','banner','coverage_defects')}
+ response=board.call('reconcile_publish',**publish)
+ if response.get('ok') is not True:raise RuntimeError('Reconciliation publication unconfirmed')
+ failures=[]
+ with Journal(journal_path) as journal:
+  for action in result['actions']:
+   try:
+    if not execute_recorded(action,journal,lambda a:execute(a,store,snapshot,board)):failures.append(action['id'])
+   except Exception:failures.append(action['id'])
+ result.update(applied=True,deferred=failures)
+ return result
+
