--- /dev/null
+++ reconciler_services.py
@@ -0,0 +1,28 @@
+"""Managed entry redirects. Legacy schedules never own reconciliation."""
+import argparse
+import json
+import sys
+
+
+def legacy_noop(*args, **kwargs):
+    return 0
+
+
+def watchdog_main(argv=None):
+    parser = argparse.ArgumentParser(add_help=False)
+    parser.add_argument('--probe', action='store_true')
+    args, _ = parser.parse_known_args(argv)
+    if args.probe:
+        print(json.dumps({'owner': 'card_reconciler', 'mode': 'managed'}))
+        return 0
+    print('recovery belongs to the dedicated card reconciler entry', file=sys.stderr)
+    return 1
+
+
+def readonly_steward(legacy):
+    def run(root=None, dry_run=False, now=None):
+        kwargs = {'dry_run': True, 'now': now}
+        if root is not None:
+            kwargs['root'] = root
+        return legacy(**kwargs)
+    return run
