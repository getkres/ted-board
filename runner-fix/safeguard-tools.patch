+import importlib.util
+import json
+import os
+from pathlib import Path
+import stat
+import subprocess
+import sys
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+MODULE = ROOT / 'scripts' / 'bounded_json_log.py'
+
+
+class BoundedLogTests(unittest.TestCase):
+    def writer(self):
+        self.assertTrue(MODULE.is_file(), 'bounded log writer must exist')
+        spec = importlib.util.spec_from_file_location('bounded_json_log', MODULE)
+        module = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(module)
+        return module.append_rows
+
+    def test_rotation_preserves_newest_records_and_limits_retention(self):
+        write = self.writer()
+        with tempfile.TemporaryDirectory() as root:
+            log = Path(root).resolve() / 'worker.log'
+            for value in range(12):
+                write(log, [{'n': value}], max_bytes=30, backups=2)
+            files = [log, log.with_name('worker.log.1'), log.with_name('worker.log.2')]
+            self.assertTrue(all(p.is_file() and p.stat().st_size <= 30 for p in files))
+            self.assertFalse(log.with_name('worker.log.3').exists())
+            rows = [json.loads(line)['n'] for p in reversed(files) for line in p.read_text().splitlines()]
+            self.assertEqual(rows, list(range(rows[0], 12)))
+            self.assertEqual(rows[-1], 11)
+            self.assertTrue(all(stat.S_IMODE(p.stat().st_mode) == 0o600 for p in files))
+
+    def test_rejects_large_record_and_symlink_before_writing(self):
+        write = self.writer()
+        with tempfile.TemporaryDirectory() as root:
+            root = Path(root).resolve()
+            log = root / 'worker.log'
+            with self.assertRaises(ValueError):
+                write(log, [{'data': 'x' * 100}], max_bytes=30)
+            self.assertFalse(log.exists())
+            target = root / 'untouched'
+            target.write_text('keep')
+            log.with_name('worker.log.1').symlink_to(target)
+            with self.assertRaises(ValueError):
+                write(log, [{'n': 1}], max_bytes=30)
+            self.assertEqual(target.read_text(), 'keep')
+            self.assertFalse(log.exists())
+
+    def test_concurrent_writers_preserve_records_across_rotation(self):
+        self.writer()
+        with tempfile.TemporaryDirectory() as root:
+            log = Path(root).resolve() / 'worker.log'
+            code = ('from scripts.bounded_json_log import append_rows; import sys; '
+                    'append_rows(sys.argv[1], [{"worker":int(sys.argv[2]),"n":i} for i in range(30)], '
+                    'max_bytes=600, backups=20)')
+            children = [subprocess.Popen([sys.executable, '-c', code, str(log), str(i)], cwd=ROOT,
+                                         stdout=subprocess.PIPE, stderr=subprocess.PIPE) for i in range(4)]
+            for child in children:
+                _, errors = child.communicate(timeout=20)
+                self.assertEqual(child.returncode, 0, errors.decode())
+            rows = [json.loads(line) for path in log.parent.glob('worker.log*')
+                    if path.suffix != '.lock' for line in path.read_text().splitlines()]
+            self.assertEqual(len(rows), 120)
+            self.assertEqual({(row['worker'], row['n']) for row in rows},
+                             {(worker, n) for worker in range(4) for n in range(30)})
+
+    def test_existing_oversized_archive_requires_preservation_before_rollout(self):
+        write = self.writer()
+        with tempfile.TemporaryDirectory() as root:
+            log = Path(root).resolve() / 'worker.log'
+            log.write_bytes(b'x' * 100)
+            with self.assertRaises(ValueError):
+                write(log, [{'n': 1}], max_bytes=30)
+            self.assertEqual(log.read_bytes(), b'x' * 100)
+            self.assertFalse(log.with_name('worker.log.1').exists())
+
+    def test_reducing_retention_requires_preserving_old_archives_first(self):
+        write = self.writer()
+        with tempfile.TemporaryDirectory() as root:
+            log = Path(root).resolve() / 'worker.log'
+            old = log.with_name('worker.log.2')
+            old.write_bytes(b'x' * 100)
+            with self.assertRaises(ValueError):
+                write(log, [{'n': 1}], max_bytes=30, backups=1)
+            self.assertEqual(old.read_bytes(), b'x' * 100)
+            self.assertFalse(log.exists())
+
+
+if __name__ == '__main__':
+    unittest.main()
