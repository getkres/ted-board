+#!/usr/bin/env python3
+"""Read-only operational checks. Inventories stay private; output uses labels only."""
+import argparse
+import datetime as dt
+import json
+import math
+import os
+from pathlib import Path
+import re
+import stat
+import sys
+
+KINDS = {'disks', 'logs', 'heartbeats', 'expiries', 'cleanup_candidates'}
+
+
+def instant(value):
+    if not isinstance(value, str):
+        raise ValueError('ISO instant required')
+    parsed = dt.datetime.fromisoformat(value.replace('Z', '+00:00'))
+    if parsed.tzinfo is None:
+        raise ValueError('timezone required')
+    return parsed
+
+
+def number(row, key, default):
+    value = row.get(key, default)
+    if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value) or value <= 0:
+        raise ValueError('positive finite number required')
+    return value
+
+
+def safe_path(value):
+    if not isinstance(value, str) or not value or '\x00' in value:
+        raise ValueError('path required')
+    path = Path(os.path.abspath(os.path.expanduser(value)))
+    # Refuse before resolving, so even a nonexistent protected path stays untouched.
+    if any(part.casefold() == 'documents' for part in path.parts):
+        raise ValueError('protected path')
+    for part in [*reversed(path.parents), path]:
+        system_alias = part in (Path('/var'), Path('/tmp'), Path('/etc')) and part.resolve() == Path('/private') / part.name
+        if part.is_symlink() and not system_alias:
+            raise ValueError('symlinks are not allowed')
+    resolved = path.resolve()
+    if any(part.casefold() == 'documents' for part in resolved.parts):
+        raise ValueError('protected path')
+    return resolved
+
+
+def open_metadata(path):
+    """Open every component without following links, including concurrent replacements."""
+    descriptor = os.open('/', os.O_RDONLY | os.O_DIRECTORY)
+    try:
+        for index, component in enumerate(path.parts[1:]):
+            flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
+            if index < len(path.parts) - 2:
+                flags |= os.O_DIRECTORY
+            next_fd = os.open(component, flags, dir_fd=descriptor)
+            os.close(descriptor)
+            descriptor = next_fd
+        return descriptor
+    except BaseException:
+        os.close(descriptor)
+        raise
+
+
+def cleanup_size(path, limit):
+    """Count logical bytes, excluding symlinks and Documents, within a strict entry budget."""
+    size = entries = excluded = 0
+    pending = [open_metadata(path)]
+    try:
+        while pending:
+            current = pending.pop()
+            try:
+                entries += 1
+                if entries > limit:
+                    return size, excluded, False
+                info = os.fstat(current)
+                if stat.S_ISREG(info.st_mode):
+                    size += info.st_size
+                elif stat.S_ISDIR(info.st_mode):
+                    with os.scandir(current) as children:
+                        for child in children:
+                            if entries + len(pending) >= limit:
+                                return size, excluded, False
+                            if child.name.casefold() == 'documents' or child.is_symlink():
+                                entries += 1
+                                excluded += 1
+                                continue
+                            pending.append(os.open(child.name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
+                                                   dir_fd=current))
+                else:
+                    return size, excluded, False
+            finally:
+                os.close(current)
+        return size, excluded, True
+    finally:
+        for descriptor in pending:
+            os.close(descriptor)
+
+
+def check_inventory(inventory, now):
+    if not isinstance(inventory, dict) or not inventory or set(inventory) - KINDS:
+        raise ValueError('invalid inventory')
+    checks = []
+    for kind, rows in inventory.items():
+        if not isinstance(rows, list):
+            raise ValueError('list required')
+        for row in rows:
+            if not isinstance(row, dict) or not isinstance(row.get('name'), str) or not re.fullmatch(r'[a-z0-9_-]{1,64}', row['name']):
+                raise ValueError('safe label required')
+            result = dict(kind=kind, name=row['name'], status='unknown')
+            if kind == 'expiries':
+                warning = number(row, 'warn_days', 30)
+                if row.get('expires_at') is not None:
+                    days = (instant(row['expires_at']) - now).total_seconds() / 86400
+                    result.update(status='warning' if days <= warning else 'ok', days_left=round(days, 2))
+            else:
+                path = safe_path(row.get('path'))
+                threshold = None
+                if kind == 'disks':
+                    threshold = number(row, 'min_free_gib', 50)
+                elif kind == 'logs':
+                    threshold = number(row, 'max_mib', 50)
+                elif kind == 'heartbeats':
+                    threshold = number(row, 'max_age_seconds', 600)
+                else:
+                    threshold = number(row, 'max_entries', 50000)
+                    if threshold != int(threshold) or threshold > 50000 or path in (Path('/'), Path.home()):
+                        raise ValueError('bounded explicit candidate required')
+                try:
+                    descriptor = open_metadata(path)
+                    try:
+                        info = os.fstat(descriptor)
+                        volume = os.fstatvfs(descriptor) if kind == 'disks' else None
+                    finally:
+                        os.close(descriptor)
+                    if kind == 'disks':
+                        free = volume.f_bavail * volume.f_frsize / 1024**3
+                        result.update(status='warning' if free < threshold else 'ok', free_gib=round(free, 2))
+                    elif kind == 'logs' and stat.S_ISREG(info.st_mode):
+                        result.update(status='warning' if info.st_size >= threshold * 1024**2 else 'ok', bytes=info.st_size)
+                    elif kind == 'heartbeats' and stat.S_ISREG(info.st_mode):
+                        age = now.timestamp() - info.st_mtime
+                        result.update(status='unknown' if age < -60 else ('warning' if age > threshold else 'ok'),
+                                      age_seconds=round(age, 1))
+                    elif kind == 'cleanup_candidates':
+                        size, excluded, complete = cleanup_size(path, int(threshold))
+                        # A candidate is a review request, never permission to delete it.
+                        result.update(status='review' if complete else 'unknown', bytes=size,
+                                      complete=complete, excluded_entries=excluded)
+                except OSError:
+                    pass
+            checks.append(result)
+    if not checks:
+        raise ValueError('at least one check required')
+    return dict(dry_run=True, status='ok' if all(c['status'] == 'ok' for c in checks) else 'attention', checks=checks)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--inventory', required=True)
+    parser.add_argument('--now', help='timezone-aware ISO instant for reproducible checks')
+    args = parser.parse_args()
+    try:
+        config = safe_path(args.inventory)
+        # Only the explicitly provided inventory is read, never a credential or log.
+        descriptor = open_metadata(config)
+        with os.fdopen(descriptor, 'rb') as stream:
+            if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
+                raise ValueError('regular inventory required')
+            payload = stream.read(1024 * 1024 + 1)
+        if len(payload) > 1024 * 1024:
+            raise ValueError('inventory too large')
+        inventory = json.loads(payload)
+        report = check_inventory(inventory, instant(args.now) if args.now else dt.datetime.now(dt.timezone.utc))
+    except (ValueError, TypeError, OSError, OverflowError, RecursionError):
+        print('Invalid or unreadable inventory; no changes made.', file=sys.stderr)
+        return 2
+    print(json.dumps(report, sort_keys=True, allow_nan=False))
+    return 0 if report['status'] == 'ok' else 1
+
+
+if __name__ == '__main__':
+    sys.exit(main())
