+def lookup_card(card_id):
+ try:rows=board_client.cards()
+ except (board_client.BoardGone,AttributeError,KeyError,TypeError):raise RuntimeError('Card snapshot could not confirm existence') from None
+ if (not isinstance(rows,list) or not rows or len(rows)>500
+     or any(not isinstance(c,dict) or not isinstance(c.get('id'),str)
+            or not re.fullmatch(r'[A-Za-z0-9._-]{1,64}',c['id'])
+            or not isinstance(c.get('project'),str) or not isinstance(c.get('section'),str) for c in rows)
+     or len({c['id'] for c in rows})!=len(rows)):
+  raise RuntimeError('Card snapshot could not confirm existence')
+ card=next((c for c in rows if c['id']==card_id),None)
+ if card is None:
+  if len(rows)>=500:raise RuntimeError('Card snapshot may be truncated')
+  raise board_client.BoardGone('Card no longer exists')
+ return card
