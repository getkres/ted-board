+# A run owns a short-lived, validated snapshot lease. No writer can be used
+# outside that run. The sole recovery permission writes stale health data only.
+SNAPSHOT_MAX_AGE = 30
+RUN = ContextVar('steward_run', default=None)
+
+
+class WritesDisabled(RuntimeError):
+    pass
+
+
+@dataclass
+class WriteState:
+    root: Path
+    cards: object = None
+    observed_at: object = None
+    failed_at: object = None
+
+
+def can_write(root, *, stale_only=False):
+    """Admit a fresh data write or the boundary's stale-only recovery write."""
+    if disabled(root):
+        raise WritesDisabled('Steward disabled')
+    state = RUN.get()
+    if state is None or state.root != Path(root).resolve():
+        raise RuntimeError('Run snapshot required')
+    observed = state.failed_at if stale_only else state.observed_at
+    if observed is None or not 0 <= time.monotonic()-observed <= SNAPSHOT_MAX_AGE:
+        raise RuntimeError('Fresh observation required')
+    if not stale_only and (state.failed_at is not None or state.cards is None):
+        raise RuntimeError('Complete snapshot required')
+    return state
+
+
