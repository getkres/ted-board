--- /dev/null
+++ claude_lanes.py
@@ -0,0 +1,227 @@
+"""Account-affine Claude lanes. Never read, copy, or exchange credentials."""
+import json
+import math
+import os
+from pathlib import Path
+import re
+import subprocess
+import time
+
+LANES = {'main': (1, '.claude'), 'design': (2, '.claude-acct2'), 'research': (3, '.claude-acct3')}
+DESIGN_TYPES = {'design', 'mockup', 'art', 'design_review'}
+RESEARCH_TYPES = {'research', 'analysis', 'review_gate', 'design_review'}
+JOB_TYPES = DESIGN_TYPES | RESEARCH_TYPES | {'interactive', 'general', 'implementation'}
+COUNTERS = ('input_tokens', 'output_tokens', 'cache_read_input_tokens', 'cache_creation_input_tokens')
+
+
+class Unavailable(RuntimeError):
+    """A safe, fixed reason for leaving a turn in its durable queue."""
+
+
+def clear_review(session):
+    for key in ('reviewing', 'review_context', 'review_session_id', 'review_claude_lane',
+                'review_claude_config_dir', 'active_claude_lane', 'active_claude_config_dir', 'active_claude_managed'):
+        session.pop(key, None)
+
+
+def config():
+    path = Path(os.environ.get('TED_CLAUDE_LANES_CONFIG', Path.home() / 'ted-ops/claude-lanes/config.json'))
+    try:
+        value = json.loads(path.read_text()) if path.exists() else {'enabled': False}
+        if not isinstance(value, dict) or type(value.get('enabled')) is not bool:
+            raise ValueError()
+        return value
+    except (OSError, ValueError):
+        raise Unavailable('waiting for valid claude lane configuration') from None
+
+
+def job_type(card, explicit=None):
+    value = explicit or card.get('job_type')
+    if value is not None:
+        if value not in JOB_TYPES:
+            raise ValueError('Invalid Claude job type')
+        return value
+    # Existing callers have titles, but do not all have structured job metadata.
+    title = card.get('title', '').lower()
+    if re.search(r'\b(?:review|gate)\b', title):
+        return 'review_gate'
+    if re.search(r'\b(?:design|mockups?|art|visuals?|illustration)\b', title):
+        return 'design'
+    return 'research' if re.search(r'\b(?:research|analysis|analyze)\b', title) else 'general'
+
+
+def environment(session, source):
+    env = dict(source)
+    directory = session.get('active_claude_config_dir')
+    if directory:
+        env['CLAUDE_CONFIG_DIR'] = directory
+    if session.get('active_claude_managed'):
+        for key in list(env):
+            if key.startswith('ANTHROPIC_') or key.startswith('CLAUDE_CODE_USE_') or key in (
+                'CLAUDE_CODE_OAUTH_TOKEN', 'CLAUDE_CODE_OAUTH_TOKEN_FILE_DESCRIPTOR',
+                'CLAUDE_CODE_API_KEY_FILE_DESCRIPTOR', 'CLAUDE_CODE_CUSTOM_HEADERS_HELPER',
+                'HTTP_PROXY', 'HTTPS_PROXY', 'ALL_PROXY', 'http_proxy', 'https_proxy', 'all_proxy'):
+                env.pop(key, None)
+    env.pop('CLAUDECODE', None)
+    return env
+
+
+def verify_account(lane, directory, claude, cwd):
+    if lane != 'main':
+        expected = Path.home() / LANES[lane][1]
+        if Path(directory) != expected or expected.is_symlink() or not expected.is_dir() or expected.resolve() == (Path.home() / '.claude').resolve():
+            raise Unavailable('waiting for separate claude account setup')
+    candidate = dict(active_claude_config_dir=directory, active_claude_managed=True)
+    try:
+        result = subprocess.run([claude, 'auth', 'status', '--json'], env=environment(candidate, os.environ),
+                                cwd=cwd, capture_output=True, text=True, timeout=10)
+        auth = json.loads(result.stdout)
+        if result.returncode or not isinstance(auth, dict) or auth.get('loggedIn') is not True or auth.get('authMethod') != 'claude.ai' or auth.get('subscriptionType') != 'max' or Path(auth.get('configDirectory', '')).resolve() != Path(directory).resolve():
+            raise ValueError()
+    except (OSError, ValueError, TypeError, subprocess.SubprocessError):
+        raise Unavailable('waiting for verified claude max login in the ' + lane + ' lane') from None
+
+
+def topology(claude, cwd):
+    result = dict(enabled=False, account2_ready=False, account3_ready=False, errors={})
+    try:
+        result['enabled'] = config()['enabled']
+    except Unavailable as exc:
+        result['error'] = str(exc)
+        return result
+    if result['enabled']:
+        for lane, key in (('design', 'account2_ready'), ('research', 'account3_ready')):
+            if lane == 'research' and not result['account2_ready']:
+                break
+            try:
+                verify_account(lane, str(Path.home() / LANES[lane][1]), claude, cwd)
+                result[key] = True
+            except Unavailable as exc:
+                result['errors'][lane] = str(exc)
+    return result
+
+
+def execution_engine(session, turn=None):
+    if (turn and turn.get('veto_proposal_id')) or session.get('active_veto_revision') is not None:
+        return None
+    if (turn and turn['kind'] == 'review') or (turn is None and session.get('reviewing')):
+        return 'claude'
+    return session.get('engine')
+
+
+def prepare(session, review, data, claude, layout=None):
+    cfg = layout if layout is not None else topology(claude, session['cwd'])
+    if cfg.get('error'):
+        raise Unavailable(cfg['error'])
+    key = 'review_claude' if review else 'claude'
+    lane = session.get(key + '_lane')
+    directory = session.get(key + '_config_dir')
+    if lane is None:
+        legacy = session.get('session_id') and not review
+        kind = session.get('job_type', 'general')
+        lane = 'main' if legacy or not cfg['enabled'] else ('research' if cfg['account3_ready'] and (review or kind in RESEARCH_TYPES) else 'design')
+        directory = str(Path.home() / LANES[lane][1])
+        if lane == 'main' and not cfg['enabled']:
+            directory = os.environ.get('CLAUDE_CONFIG_DIR', directory)
+    if lane not in LANES or not isinstance(directory, str) or not Path(directory).is_absolute():
+        raise Unavailable('waiting for valid claude session affinity')
+    if lane != 'main' and not cfg['enabled']:
+        raise Unavailable('waiting for claude lanes to be enabled')
+    if lane != 'main':
+        if not cfg['account2_ready'] or (lane == 'research' and not cfg['account3_ready']):
+            raise Unavailable(cfg['errors'].get(lane, 'waiting for separate claude account setup'))
+    state = data.get('claude_lanes', {}).get(lane, {})
+    if number(state.get('resets_at')) and state['resets_at'] > time.time():
+        raise Unavailable('waiting for the ' + lane + ' lane usage limit to reset')
+    candidate = dict(session, active_claude_lane=lane, active_claude_config_dir=directory, active_claude_managed=cfg['enabled'] or lane != 'main')
+    if candidate['active_claude_managed']:
+        verify_account(lane, directory, claude, session['cwd'])
+    session.update({key + '_lane': lane, key + '_config_dir': directory,
+                    'active_claude_lane': lane, 'active_claude_config_dir': directory,
+                    'active_claude_managed': candidate['active_claude_managed']})
+
+
+def number(value):
+    return type(value) in (int, float) and math.isfinite(value) and 0 <= value < 10**12
+
+
+def observe(events):
+    """Extract only numerical usage and typed CLI limit signals, never text."""
+    observed = {}
+    for event in events:
+        if not isinstance(event, dict):
+            continue
+        if event.get('type') == 'result':
+            usage = event.get('usage')
+            if isinstance(usage, dict):
+                for key in COUNTERS:
+                    if type(usage.get(key)) is int and number(usage[key]):
+                        observed[key] = usage[key]
+            if event.get('is_error') and isinstance(event.get('result'), str) and re.search(r"you.ve hit your limit|usage limit|rate.limit", event['result'], re.I):
+                observed['limited'] = True
+        if event.get('type') == 'assistant' and event.get('error') == 'rate_limit':
+            observed['limited'] = True
+        if event.get('type') == 'rate_limit_event':
+            info = event.get('rate_limit_info', event.get('rateLimitInfo', {}))
+            if not isinstance(info, dict):
+                continue
+            status = info.get('status')
+            if status in ('allowed', 'allowed_warning', 'rejected'):
+                observed['limit_status'] = status
+            if status == 'rejected':
+                observed['limited'] = True
+                reset = info.get('resetsAt')
+                if number(reset):
+                    observed['resets_at'] = max(observed.get('resets_at', 0), reset)
+    return observed
+
+
+def record(data, session, result):
+    lane = session.get('active_claude_lane')
+    if lane not in LANES:
+        return False
+    usage = result.get('lane_usage', {})
+    if not isinstance(usage, dict):
+        usage = {}
+    state = data.setdefault('claude_lanes', {}).setdefault(lane, {})
+    for key in COUNTERS:
+        if type(usage.get(key)) is int and number(usage[key]):
+            state[key] = state.get(key, 0) + usage[key]
+    state['observed_at'] = time.time()
+    if usage.get('limit_status') in ('allowed', 'allowed_warning', 'rejected'):
+        state['limit_status'] = usage['limit_status']
+    if usage.get('limited') is True:
+        reset = usage.get('resets_at')
+        state['resets_at'] = reset if number(reset) and reset > time.time() else time.time() + 300
+        state['limit_status'] = 'rejected'
+        return True
+    return False
+
+
+def summaries(data):
+    try:
+        enabled = config()['enabled']
+        config_error = False
+    except Unavailable:
+        enabled = False
+        config_error = True
+    jobs = []
+    layout = data.get('claude_lane_topology', {})
+    for lane, (account, _) in LANES.items():
+        state = data.get('claude_lanes', {}).get(lane, {})
+        limited = number(state.get('resets_at')) and state['resets_at'] > time.time()
+        status = 'configuration needed' if config_error else 'disabled' if not enabled else 'limited' if limited else 'reserved for ted and interactive work' if lane == 'main' else 'not yet observed'
+        if enabled and not limited and state.get('observed_at') and lane != 'main':
+            status = 'last observed: ' + state.get('limit_status', 'no limit signal')
+        if enabled and not config_error:
+            if lane == 'design' and not layout.get('account2_ready'):
+                status = 'waiting for account 2 login verification'
+            if lane == 'research' and not layout.get('account3_ready'):
+                status = 'not configured; new research and review use account 2'
+        role = 'all_managed' if lane == 'design' and not layout.get('account3_ready') else 'design_workers' if lane == 'design' else 'research_review' if lane == 'research' else 'interactive'
+        safe_usage = {key: state[key] for key in COUNTERS if number(state.get(key))}
+        safe_usage.update({key: state[key] for key in ('observed_at', 'resets_at') if number(state.get(key))})
+        jobs.append(dict(id='claude-lane-' + lane, card_id=None, title='Claude account ' + str(account) + ': ' + lane,
+                         engine='claude', status='idle', pid=None, identity='', last_line=status,
+                         lane_summary=True, lane_role=role, lane_usage=safe_usage))
+    return jobs
