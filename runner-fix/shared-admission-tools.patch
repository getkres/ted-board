+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import time
+import unittest
+from unittest import mock
+
+try:
+    from scripts import shared_admission as admission
+except ImportError:
+    admission = None
+
+GIB = 1024 ** 3
+
+
+class SharedAdmissionTests(unittest.TestCase):
+    def setUp(self):
+        self.assertIsNotNone(admission, 'shared admission implementation is missing')
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.root = Path(self.tmp.name).resolve() / 'budget'
+        self.pressure = dict(cores=18, load=0.0, available_bytes=10 * GIB, total_bytes=64 * GIB)
+        self.gate = admission.Gate(self.root, sample=lambda: self.pressure)
+
+    def spawn(self, code='import time; time.sleep(2)', lane='direct'):
+        child = self.gate.spawn([sys.executable, '-c', code], lane=lane,
+                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+        self.addCleanup(self.stop, child)
+        return child
+
+    @staticmethod
+    def stop(child):
+        if child.poll() is None:
+            os.killpg(child.pid, 15)
+        child.wait(timeout=5)
+
+    def test_rejects_before_command_side_effect_when_memory_is_low(self):
+        marker = self.root.parent / 'ran'
+        self.pressure['available_bytes'] = 3 * GIB
+        with self.assertRaises(admission.Deferred):
+            self.spawn('from pathlib import Path; Path(%r).touch()' % str(marker))
+        self.assertFalse(marker.exists())
+
+    def test_load_ceiling_is_scaled_to_cores(self):
+        self.pressure.update(cores=2, load=4.0)
+        with self.assertRaises(admission.Deferred):
+            self.spawn()
+
+    def test_all_lanes_share_reserved_memory(self):
+        # 10 GiB available, 6.4 GiB floor, and one 2 GiB reservation fits.
+        first = self.spawn(lane='board')
+        with self.assertRaises(admission.Deferred):
+            self.spawn(lane='launchd')
+        first.terminate()
+        first.wait(timeout=5)
+        second = self.spawn(lane='direct')
+        self.assertIsNone(second.poll())
+
+    def test_unknown_pressure_refuses_without_overwriting_state(self):
+        self.spawn()
+        before = (self.root / 'leases.json').read_bytes()
+        self.pressure['available_bytes'] = None
+        with self.assertRaises(admission.Deferred):
+            self.spawn()
+        self.assertEqual((self.root / 'leases.json').read_bytes(), before)
+
+    def test_corrupt_or_linked_state_is_refused(self):
+        self.root.mkdir(mode=0o700)
+        state = self.root / 'leases.json'
+        state.write_text('{')
+        with self.assertRaises(admission.Deferred):
+            self.spawn()
+        self.assertEqual(state.read_text(), '{')
+        state.unlink()
+        target = self.root / 'keep'
+        target.write_text('preserve')
+        state.symlink_to(target)
+        with self.assertRaises(admission.Deferred):
+            self.spawn()
+        self.assertEqual(target.read_text(), 'preserve')
+
+    def test_directory_replacement_cannot_redirect_state(self):
+        self.root.mkdir(mode=0o700)
+        target = self.root.parent / 'other'
+        target.mkdir(mode=0o700)
+        original = Path.is_symlink
+        replaced = False
+        def check(path):
+            nonlocal replaced
+            result = original(path)
+            if path == self.root and not replaced:
+                replaced = True
+                path.rename(path.with_name('original'))
+                path.symlink_to(target, target_is_directory=True)
+            return result
+        with mock.patch.object(Path, 'is_symlink', check):
+            with self.assertRaises(admission.Deferred):
+                self.spawn()
+        self.assertEqual(list(target.iterdir()), [])
+
+    def test_child_executes_only_after_a_committed_matching_lease(self):
+        marker = self.root.parent / 'ran'
+        child = self.spawn('from pathlib import Path; Path(%r).touch()' % str(marker))
+        self.assertEqual(child.wait(timeout=5), 0)
+        self.assertTrue(marker.exists())
+        leases = json.loads((self.root / 'leases.json').read_text())['leases']
+        self.assertEqual(leases[0]['pgid'], child.pid)
+        self.assertEqual((self.root / 'leases.json').stat().st_mode & 0o777, 0o600)
+        self.assertEqual((self.root / 'gate.lock').stat().st_mode & 0o777, 0o600)
+
+    def test_uncommitted_child_does_not_execute(self):
+        marker = self.root.parent / 'ran'
+        script = Path(admission.__file__)
+        result = subprocess.run([sys.executable, str(script), '_child', '--state-dir', str(self.root),
+                                 '--token', 'missing', '--', sys.executable, '-c',
+                                 'from pathlib import Path; Path(%r).touch()' % str(marker)],
+                                capture_output=True, text=True, timeout=10)
+        self.assertEqual(result.returncode, 75)
+        self.assertFalse(marker.exists())
+
+    def test_failed_state_commit_cannot_start_command(self):
+        marker = self.root.parent / 'ran'
+        with mock.patch.object(self.gate, 'write', side_effect=OSError('private-sentinel')):
+            with self.assertRaises(admission.Deferred):
+                self.spawn('from pathlib import Path; Path(%r).touch()' % str(marker))
+        self.assertFalse(marker.exists())
+
+    def test_exited_helper_during_failed_commit_still_defers(self):
+        with mock.patch.object(self.gate, 'write', side_effect=OSError('private-sentinel')), \
+             mock.patch.object(os, 'killpg', side_effect=ProcessLookupError):
+            with self.assertRaises(admission.Deferred):
+                self.spawn()
+
+    def test_cli_preserves_arguments_and_exit_status(self):
+        marker = self.root.parent / 'literal argument'
+        with mock.patch.object(admission, 'Gate', return_value=self.gate):
+            status = admission.main(['run', '--lane', 'direct', '--state-dir', str(self.root), '--',
+                                     sys.executable, '-c',
+                                     'import pathlib,sys; pathlib.Path(sys.argv[1]).write_text(sys.argv[2]); sys.exit(17)',
+                                     str(marker), 'literal $(no-substitution)'])
+        self.assertEqual(status, 17)
+        self.assertEqual(marker.read_text(), 'literal $(no-substitution)')
+
+    def test_process_group_keeps_reservation_after_leader_exits(self):
+        child = self.spawn('import subprocess,sys; subprocess.Popen([sys.executable,"-c","import time; time.sleep(2)"])')
+        self.assertEqual(child.wait(timeout=5), 0)
+        with self.assertRaises(admission.Deferred):
+            self.spawn(lane='launchd')
+        time.sleep(2.2)
+        self.spawn()
+
+    def test_concurrent_processes_cannot_over_admit(self):
+        # Hold the sole available reservation until every competing caller exits.
+        start = self.root.parent / 'start'
+        code = '''import pathlib,sys,time
+from scripts.shared_admission import Gate,Deferred
+p=pathlib.Path(sys.argv[1]); marker=pathlib.Path(sys.argv[2])
+while not marker.exists(): time.sleep(.01)
+g=Gate(p,sample=lambda: dict(cores=18,load=0,available_bytes=10*1024**3,total_bytes=64*1024**3))
+try: g.spawn([sys.executable,'-c','import time; time.sleep(3)'],lane=sys.argv[3],stdout=-3,stderr=-3)
+except Deferred: sys.exit(75)
+'''
+        callers = [subprocess.Popen([sys.executable, '-c', code, str(self.root), str(start), lane])
+                   for lane in ['board', 'direct', 'launchd', 'direct']]
+        start.touch()
+        results = [p.wait(timeout=10) for p in callers]
+        self.assertEqual(sorted(results), [0, 75, 75, 75])
+        leases = json.loads((self.root / 'leases.json').read_text())['leases']
+        for lease in leases:
+            try:
+                os.killpg(lease['pgid'], 15)
+            except ProcessLookupError:
+                pass
+
+    def test_darwin_memory_parser_excludes_compressed_and_wired_pages(self):
+        vm = ('Mach Virtual Memory Statistics: (page size of 16384 bytes)\n'
+              'Pages free: 100.\nPages inactive: 200.\nPages speculative: 50.\n'
+              'Pages wired down: 9000.\nPages occupied by compressor: 8000.\n')
+        self.assertEqual(admission.parse_vm_stat(vm), 5_734_400)
+        with self.assertRaises(ValueError):
+            admission.parse_vm_stat('unknown')
+
+
+if __name__ == '__main__':
+    unittest.main()
