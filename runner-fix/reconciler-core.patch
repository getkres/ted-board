+   pr=snapshot.get('prs',{}).get(w.get('pr_url'),{})
+   started=max(started,stamp(pr.get('merged_at') if stage=='merged' else pr.get('created_at') if stage=='pr' else w.get('deployment',{}).get('deployed_at') if stage=='deployed' else w.get('verification',{}).get('verified_at')) or started)
+  due=(0 if transition else stamp(c.get('next_action_due'))) or started+(6*3600 if review else 2*3600)
+  row=item('card:'+cid,'card',cid,owner,started,due,stage,priority=priority_key(c)[0],summary='card requires next action',expected=c.get('updated_at'))
+  if not valid_owner or not stamp(c.get('next_action_due')) or owner!=c.get('owner'):
+   action('repair_metadata',cid,c.get('updated_at'),dict(card_id=cid,owner=owner,next_action_due=iso(due),action_started_at=iso(started)))
+  if c.get('section')=='needs_you' and not reserved(c) and not c.get('classification_uncertain'):
+   action('route_ted',cid,c.get('updated_at'),dict(card_id=cid,expected_updated_at=c.get('updated_at')))
+  age=max(0,now-started)
+  for hours,kind in ((2,'escalate_2h'),(12,'escalate_12h')):
+   if age>=hours*3600 and now>=due:action(kind,cid,[stage,iso(started)],dict(card_id=cid,owner='ted'))
+  if age>=24*3600 and now>=due and owner=='sebastian' and reserved(c):action('sebastian_escalation',cid,[stage,iso(started)],dict(card_id=cid))
+  if review:
+   review_ids.append(row)
+   if age>=6*3600:action('review_sla',cid,[stage,iso(started)],dict(card_id=cid))
+  if has_chain:
